---
import { LOCALES, localizePath, messagesFor, unlocalizedPath } from '../i18n';

const { locale, site: t } = messagesFor(Astro.url);
const path = unlocalizedPath(Astro.url.pathname);
---

<div class="lang-menu">
  <button
    class="icon-btn"
    aria-label={t.header.language}
    aria-haspopup="menu"
    aria-expanded="false"
    data-lang-toggle
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="8" cy="8" r="6.3"></circle>
      <path d="M1.9 8h12.2M8 1.7c-3.6 3.6-3.6 9 0 12.6M8 1.7c3.6 3.6 3.6 9 0 12.6"></path>
    </svg>
    <span class="tip">{t.header.language}</span>
  </button>
  <div class="lang-menu-list" role="menu" hidden>
    {LOCALES.map((l) => (
      <a
        role="menuitemradio"
        aria-checked={l.code === locale ? 'true' : 'false'}
        class:list={['lang-option', { 'is-on': l.code === locale }]}
        href={localizePath(l.code, path)}
        hreflang={l.lang}
        lang={l.lang}
      >
        <span class="lang-name">{l.name}</span>
        <span class="lang-check">✓</span>
      </a>
    ))}
  </div>
</div>

<script>
  import { LOCALE_CHOSEN_KEY } from '../lib/locale-choice';

  const menu = document.querySelector<HTMLElement>('.lang-menu')!;
  const toggle = menu.querySelector<HTMLButtonElement>('[data-lang-toggle]')!;
  const list = menu.querySelector<HTMLElement>('.lang-menu-list')!;

  function setOpen(open: boolean) {
    list.hidden = !open;
    toggle.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
  }

  toggle.addEventListener('click', () => setOpen(list.hasAttribute('hidden')));
  document.addEventListener('click', (e) => {
    if (!menu.contains(e.target as Node)) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  list.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest('a');
    if (link) {
      try {
        localStorage.setItem(LOCALE_CHOSEN_KEY, '1');
      } catch {}
      const target = new URL(link.href);
      target.hash = location.hash;
      link.href = target.href;
    }
  });
</script>

<style>
  .lang-menu {
    position: relative;
  }

  .lang-menu-list {
    position: absolute;
    top: 40px;
    right: 0;
    z-index: 61;
    width: 220px;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
    padding: 6px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.16);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .lang-menu-list[hidden] {
    display: none;
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    font: 400 13.5px/1.2 var(--ui);
    color: var(--ink);
  }

  .lang-option:hover {
    background: var(--hover);
    color: var(--ink);
  }

  .lang-option.is-on {
    background: var(--fill);
    font-weight: 600;
  }

  .lang-name {
    flex: 1;
  }

  .lang-check {
    font: 600 12px/1 system-ui;
    color: var(--acc);
    opacity: 0;
  }

  .lang-option.is-on .lang-check {
    opacity: 1;
  }
</style>
