---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { crisp } from '../../lib/screenshots';

type Props = { label: string; src?: ImageMetadata; dark?: ImageMetadata };
const { label, src, dark } = Astro.props;

// The manual's column width, so 2x screens don't shrink the image and blur its text.
const COLUMN_WIDTH = 720;
const widthOf = (image: ImageMetadata) =>
  Math.min(image.width / 2, COLUMN_WIDTH);
---

{src ? (
  <>
    <Image
      class:list={['shot-image', { 'is-light': dark }]}
      src={src}
      alt={label}
      width={widthOf(src)}
      densities={[1, 2]}
      {...crisp(src)}
    />
    {dark && (
      <Image
        class="shot-image is-dark"
        src={dark}
        alt={label}
        width={widthOf(dark)}
        densities={[1, 2]}
        {...crisp(dark)}
      />
    )}
  </>
) : (
  <div class="shot" role="img" aria-label={label}>
    Screenshot: {label}
  </div>
)}
