---
import { VIDEO_ID } from '../lib/links';
import { messagesFor } from '../i18n';

const {
  site: { home: t },
} = messagesFor(Astro.url);
---

<div class="video-embed">
  <iframe
    title={t.video}
    data-src={`https://www.youtube-nocookie.com/embed/${VIDEO_ID}?rel=0`}
    allow="encrypted-media; picture-in-picture; fullscreen"
    allowfullscreen
    loading="lazy"
  ></iframe>
</div>

<script>
  // Hidden iframes still load, so the player only gets its source where it shows.
  const frame = document.querySelector<HTMLIFrameElement>(
    '.video-embed iframe',
  )!;
  const phone = matchMedia('(max-width: 639px)');
  const load = () => {
    if (phone.matches && !frame.src) frame.src = frame.dataset.src!;
  };
  load();
  phone.addEventListener('change', load);
</script>

<style>
  .video-embed {
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 16px 40px rgba(25, 27, 31, 0.1);
  }

  .video-embed iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
