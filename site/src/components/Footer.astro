---
import { LINKS } from '../lib/links';
---

<footer class="site-footer">
  <a href={LINKS.changelog} class="mono">
    v4
  </a>
  <a href={LINKS.changelog}>Changelog</a>
  <a href={LINKS.donate} class="coffee">
    <svg
      width="15"
      height="15"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M2.5 6h9v4.5a3 3 0 0 1-3 3h-3a3 3 0 0 1-3-3z"></path>
      <path d="M11.5 7.2h.8a1.9 1.9 0 0 1 0 3.8h-.9"></path>
      <path d="M5 1.8c-.5.6-.5 1.2 0 1.8M8 1.8c-.5.6-.5 1.2 0 1.8"></path>
    </svg>
    Buy me a coffee
  </a>
  <span class="site-footer-copy">
    © {new Date().getFullYear()} <a href={LINKS.author}>Ankit Ahuja</a>
  </span>
</footer>

<style>
  .coffee {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    line-height: 1;
  }

  .coffee svg {
    display: block;
    flex: none;
    margin-top: -3px;
  }
</style>
