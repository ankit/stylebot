---
import Logo from './Logo';
import ThemeMenu from './ThemeMenu';
import StoreLink from './StoreLink.astro';
import { LINKS } from '../lib/links';

type Props = { current?: 'manual'; storeCta?: boolean };
const { current, storeCta = false } = Astro.props;
---

<header class="site-header">
  <div class="site-header-inner">
    <Logo client:idle />
    <div class="header-actions">
      <ThemeMenu client:idle />
      <a
        href={LINKS.manual}
        class:list={['icon-btn', { 'is-current': current === 'manual' }]}
        aria-label="Manual"
        aria-current={current === 'manual' ? 'page' : undefined}
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M8 3.6C6.6 2.6 4.6 2.2 2 2.4v10c2.6-.2 4.6.2 6 1.2 1.4-1 3.4-1.4 6-1.2v-10c-2.6-.2-4.6.2-6 1.2z"></path>
          <path d="M8 3.6v10" stroke-linecap="round"></path>
        </svg>
        <span class="tip">Manual</span>
      </a>
      <a href={LINKS.github} class="icon-btn" aria-label="GitHub">
        <svg
          width="18"
          height="18"
          viewBox="0 0 16 16"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
        <span class="tip">GitHub</span>
      </a>
      {!storeCta ? (
        <a href="/#install" class="btn btn-primary btn-sm">
          Install
        </a>
      ) : (
        <StoreLink index={0} format="add" class="btn btn-primary btn-sm" />
      )}
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header')!;
  const update = () =>
    header.classList.toggle('is-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
