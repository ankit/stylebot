---
import CarouselNav from './CarouselNav.astro';
import { ChevronDown } from './icons';
import {
  ChatComposer,
  ChatEmpty,
  FIRST_DECK,
  MORNING_NEWSPAPER,
} from './chat/Chat';
---

<section id="features" class="section features">
  <div class="section-inner">
    <div class="section-head">
      <h2 class="section-title" style="max-width:22ch">
        Everything else you get.
      </h2>
      <CarouselNav target="features-track" label="feature" />
    </div>
    <div id="features-track" class="carousel features-track">
      <article class="feature">
        <div class="feature-mock" aria-hidden="true">
          <div data-ed class="mock-card">
            <div class="sync-head">
              <div class="sync-status">
                <span class="mock-title">Connected to Google Drive</span>
                <span class="sync-pill">
                  <span class="dot"></span>Synced 2 minutes ago
                </span>
              </div>
              <span class="mock-btn sync-now">
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 14 14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 5.5A5 5 0 0 0 3 4M2 8.5A5 5 0 0 0 11 10"></path>
                  <path d="M3 1.5V4h2.5M11 12.5V10H8.5"></path>
                </svg>
                Sync now
              </span>
            </div>
            <div class="sync-grid">
              <span class="muted">Saved to</span>
              <span class="sync-path">
                you@gmail.com <span class="faint">›</span>
              </span>
              <span class="mock-link">Disconnect</span>
              <span class="sync-file">stylebot/stylebot_v3_backup.json ↗</span>
              <span class="muted">Schedule</span>
              <span class="sync-schedule">
                Every 30 minutes, and right after you edit a style
              </span>
            </div>
          </div>
        </div>
        <div class="feature-text">
          <h3>Sync</h3>
          <p>
            Connect Google Drive and your styles follow you to every computer
            you sign in to. Stylebot syncs every 30 minutes and right after you
            edit.
          </p>
        </div>
      </article>

      <article class="feature">
        <div class="feature-mock" aria-hidden="true">
          <div data-ed class="mock-card">
            <div class="hist-day">Today, Sep 25</div>
            <div class="hist-row">
              <span class="hist-time">1:04 AM</span>
              <span class="hist-what">
                <span style="color:var(--ink2)">No changes</span>
              </span>
              <span class="faint">10 sites</span>
              <span class="hist-current">Current</span>
            </div>
            <div class="hist-row">
              <span class="hist-time">12:41 AM</span>
              <span class="hist-what">
                <span class="acc">Edited</span>&nbsp; <b>github.com</b>
              </span>
              <span class="faint">10 sites</span>
              <span class="hist-chev">
                <ChevronDown />
              </span>
            </div>
            <div class="hist-day">Yesterday, Sep 24</div>
            <div class="hist-row last">
              <span class="hist-time">11:41 PM</span>
              <span class="hist-what">
                <span class="acc">Edited</span>&nbsp;{' '}
                <b>news.ycombinator.com</b>
              </span>
              <span class="faint">10 sites</span>
              <span class="hist-chev">
                <ChevronDown />
              </span>
            </div>
          </div>
        </div>
        <div class="feature-text">
          <h3>Version history</h3>
          <p>
            Every change to your styles is kept, newest first. Open an entry to
            see what changed and restore it in one click.
          </p>
        </div>
      </article>

      <article class="feature">
        <div class="feature-mock" aria-hidden="true">
          <div data-ed class="mock-card chat-mock">
            <div class="chat-mock-body">
              <ChatEmpty
                decks={[[FIRST_DECK[0], FIRST_DECK[1], MORNING_NEWSPAPER]]}
                hoverable
              />
            </div>
            <div class="chat-mock-compose">
              <ChatComposer short />
            </div>
          </div>
        </div>
        <div class="feature-text">
          <h3>Stylebot agent</h3>
          <p>
            Describe the change you want. The agent finds the right elements,
            writes the CSS, and adds it to the site's style, where you can undo
            it or edit it by hand. Bring your own Claude, OpenAI or Gemini key;
            it stays in your browser.
          </p>
        </div>
      </article>

      <article class="feature">
        <div class="feature-mock" aria-hidden="true">
          <div data-ed class="preset-list">
            <div class="mock-card preset">
              <div class="preset-head">
                <span class="mock-title">Readability</span>
                <span class="switch on">
                  <span></span>
                </span>
                <span class="preset-note">Articles only</span>
              </div>
              <div class="preset-body">
                A clean reading view, with your choice of theme, font, and size.
              </div>
            </div>
            <div class="mock-card preset">
              <div class="preset-head">
                <span class="mock-title">Grayscale</span>
                <span class="switch">
                  <span></span>
                </span>
              </div>
              <div class="preset-body">Apply grayscale to the page.</div>
            </div>
          </div>
        </div>
        <div class="feature-text">
          <h3>Presets</h3>
          <p>
            Readability and grayscale work on any site, and they stack with your
            own changes.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .features {
    background: var(--surface);
  }

  .features-track {
    padding-bottom: 4px;
  }

  .feature {
    flex: 0 0 min(440px, 86%);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .feature-text {
    min-width: 0;
    padding: 0 4px;
  }

  .feature-text h3 {
    font: 600 20px/1.25 var(--display);
    letter-spacing: -0.015em;
    margin: 0 0 8px;
    color: var(--ink);
  }

  .feature-text p {
    font: 400 15px/1.6 var(--ui);
    color: var(--muted);
    margin: 0;
    max-width: 44ch;
    text-wrap: pretty;
  }

  .feature-mock {
    height: 400px;
    border-radius: 16px;
    background: var(--fill);
    border: 1px solid var(--border);
    display: grid;
    align-content: center;
    padding: 24px;
    overflow: hidden;
    color: var(--ink);
    font: 400 12.5px/1.4 var(--ui);
  }

  .feature-mock > [data-ed] {
    color: var(--ink);
  }

  .mock-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .mock-title {
    font: 600 14px/1.25 var(--ui);
    color: var(--ink);
  }

  .mock-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 13px;
    border-radius: 8px;
    border: 1px solid var(--strong);
    background: var(--surface);
    font: 600 12.5px/1 var(--ui);
    color: var(--ink);
  }

  .mock-link {
    font: 600 12.5px/1 var(--ui);
    color: var(--acc);
  }

  .muted {
    color: var(--muted);
  }

  .faint {
    color: var(--faint);
    flex: none;
  }

  .acc {
    color: var(--acc);
  }

  .sync-head {
    padding: 14px 16px;
    background: var(--fill);
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .sync-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 9px;
    border-radius: 12px;
    border: 1px solid #bfe3cc;
    background: #eef8f1;
    font: 600 11.5px/1 var(--ui);
    color: #1f7a45;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: #1f8a4c;
  }

  :global(:root:is([data-theme='dark'], [data-theme='stylebot'])) .sync-pill {
    border-color: #24563a;
    background: #173a24;
    color: #6fdd8b;
  }

  :global(:root:is([data-theme='dark'], [data-theme='stylebot'])) .dot {
    background: #4ac26b;
  }

  .sync-grid {
    padding: 14px 16px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 10px 14px;
  }

  .sync-path {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sync-schedule {
    grid-column: span 2;
  }

  .sync-status {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .sync-now {
    margin-left: auto;
  }

  .sync-file {
    grid-column: 2 / span 2;
    margin-top: -4px;
    font: 400 11px/1.4 var(--mono);
    color: var(--acc);
  }

  .hist-day {
    padding: 10px 16px;
    background: var(--fill);
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    line-height: 1.2;
  }

  .hist-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    font: 400 13px/1.2 var(--ui);
  }

  .hist-row.last {
    border-bottom: none;
  }

  .hist-row b {
    font-weight: 600;
  }

  .hist-time {
    width: 66px;
    flex: none;
    color: var(--muted);
  }

  .hist-what {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .hist-current {
    padding: 4px 9px;
    border-radius: 10px;
    border: 1px solid var(--accline);
    background: var(--acctint);
    font: 600 11.5px/1 var(--ui);
    color: var(--acc);
    flex: none;
  }

  .hist-chev {
    width: 52px;
    flex: none;
    display: flex;
    justify-content: flex-end;
    color: var(--faint);
  }

  .chat-mock {
    --ui: 'Geist', system-ui, sans-serif;
    --mono: 'Geist Mono', ui-monospace, monospace;

    display: flex;
    flex-direction: column;
  }

  .chat-mock-body {
    padding: 14px 14px 12px 16px;
  }

  .chat-mock-body :global(.chat-empty) {
    gap: 12px;
  }

  .chat-mock-compose {
    padding: 0 16px 10px;
  }

  .preset-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .preset {
    padding: 14px 16px;
  }

  .preset-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .preset-note {
    margin-left: auto;
    font: 400 12px/1 var(--ui);
    color: var(--muted);
  }

  .preset-body {
    margin-top: 8px;
    color: var(--muted);
    line-height: 1.5;
  }

  .switch {
    width: 36px;
    height: 20px;
    border-radius: 10px;
    flex: none;
    position: relative;
    background: var(--strong);
  }

  .switch > span {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
  }

  .switch.on {
    background: var(--acc);
  }

  .switch.on > span {
    left: 18px;
  }
</style>
