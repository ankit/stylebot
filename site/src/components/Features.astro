---
import CarouselNav from './CarouselNav.astro';
import { ChevronDown } from './icons';
---

<section id="features" class="section features">
  <div class="section-inner">
    <div class="section-head">
      <h2 class="section-title" style="max-width:22ch">
        Everything else you get.
      </h2>
      <CarouselNav target="features-track" label="feature" />
    </div>
    <div id="features-track" class="carousel features-track">
      <article class="feature">
        <div class="feature-mock" aria-hidden="true">
          <div data-ed class="mock-card">
            <div class="sync-head">
              <div class="sync-status">
                <span class="mock-title">Connected to Google Drive</span>
                <span class="sync-pill">
                  <span class="dot"></span>Synced 2 minutes ago
                </span>
              </div>
              <span class="mock-btn sync-now">
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 14 14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 5.5A5 5 0 0 0 3 4M2 8.5A5 5 0 0 0 11 10"></path>
                  <path d="M3 1.5V4h2.5M11 12.5V10H8.5"></path>
                </svg>
                Sync now
              </span>
            </div>
            <div class="sync-grid">
              <span class="muted">Saved to</span>
              <span class="sync-path">
                you@gmail.com <span class="faint">›</span>
              </span>
              <span class="mock-link">Disconnect</span>
              <span class="sync-file">stylebot/stylebot_v3_backup.json ↗</span>
              <span class="muted">Schedule</span>
              <span class="sync-schedule">
                Every 30 minutes, and right after you edit a style
              </span>
            </div>
          </div>
        </div>
        <div class="feature-text">
          <h3>Sync</h3>
          <p>
            Connect Google Drive and your styles follow you to every computer
            you sign in to. Stylebot syncs every 30 minutes and right after you
            edit.
          </p>
        </div>
      </article>

      <article class="feature">
        <div class="feature-mock" aria-hidden="true">
          <div data-ed class="mock-card">
            <div class="hist-day">Today, Sep 25</div>
            <div class="hist-row">
              <span class="hist-time">1:04 AM</span>
              <span class="hist-what">
                <span style="color:var(--ink2)">No changes</span>
              </span>
              <span class="faint">10 sites</span>
              <span class="hist-current">Current</span>
            </div>
            <div class="hist-row">
              <span class="hist-time">12:41 AM</span>
              <span class="hist-what">
                <span class="acc">Edited</span>&nbsp; <b>github.com</b>
              </span>
              <span class="faint">10 sites</span>
              <span class="hist-chev">
                <ChevronDown />
              </span>
            </div>
            <div class="hist-day">Yesterday, Sep 24</div>
            <div class="hist-row last">
              <span class="hist-time">11:41 PM</span>
              <span class="hist-what">
                <span class="acc">Edited</span>&nbsp;{' '}
                <b>news.ycombinator.com</b>
              </span>
              <span class="faint">10 sites</span>
              <span class="hist-chev">
                <ChevronDown />
              </span>
            </div>
          </div>
        </div>
        <div class="feature-text">
          <h3>Version history</h3>
          <p>
            Every change to your styles is kept, newest first. Open an entry to
            see what changed and restore it in one click.
          </p>
        </div>
      </article>

      <article class="feature">
        <div class="feature-mock" aria-hidden="true">
          <div data-ed class="preset-list">
            <div class="mock-card preset">
              <div class="preset-head">
                <span class="mock-title">Readability</span>
                <span class="switch on">
                  <span></span>
                </span>
                <span class="preset-note">Articles only</span>
              </div>
              <div class="preset-body">
                A clean reading view, with your choice of theme, font, and size.
              </div>
            </div>
            <div class="mock-card preset">
              <div class="preset-head">
                <span class="mock-title">Grayscale</span>
                <span class="switch">
                  <span></span>
                </span>
              </div>
              <div class="preset-body">Apply grayscale to the page.</div>
            </div>
          </div>
        </div>
        <div class="feature-text">
          <h3>Presets</h3>
          <p>
            Readability and grayscale work on any site, and they stack with your
            own changes.
          </p>
        </div>
      </article>

      <article class="feature">
        <div class="feature-mock" aria-hidden="true">
          <div data-ed class="mock-card chat-card">
            <div class="chat-thread">
              <div class="chat-msg">
                Make the article easier to read at night
              </div>
              <div class="chat-reply">
                <p>
                  Switched to a dark background with warmer text, and set the
                  body in a larger serif with more line spacing.
                </p>
                <div class="chat-change">
                  <svg viewBox="0 0 28 24" width="12" height="10">
                    <rect width="24" height="5" rx="2.5" fill="#ec4d86" />
                    <rect
                      y="8.5"
                      width="15"
                      height="5"
                      rx="2.5"
                      fill="#1c9fc4"
                    />
                    <rect
                      y="17"
                      width="18"
                      height="5"
                      rx="2.5"
                      fill="#e0a218"
                    />
                    <rect
                      x="24.5"
                      y="13"
                      width="3.5"
                      height="11"
                      rx="1.5"
                      fill="#2563eb"
                    />
                  </svg>
                  <span class="chat-change-label">Updated styles</span>
                  <span class="chat-diff">
                    <span class="chat-added">+14</span>
                    <span class="chat-diff-open">
                      <svg
                        viewBox="0 0 16 16"
                        width="12"
                        height="12"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M6.5 3.5 11 8l-4.5 4.5" />
                      </svg>
                    </span>
                  </span>
                  <span class="chat-undo">
                    <svg
                      viewBox="0 0 16 16"
                      width="14"
                      height="14"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M6 3L3 6l3 3" />
                      <path d="M3 6h6.5a3.5 3.5 0 0 1 0 7H7" />
                    </svg>
                    Undo
                  </span>
                </div>
              </div>
            </div>
            <div class="chat-composer">
              <div class="chat-input">
                <div class="chat-placeholder">Describe a change</div>
                <div class="chat-tools">
                  <span class="chat-attach">
                    <svg
                      viewBox="0 0 16 16"
                      width="16"
                      height="16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="2" y="3" width="12" height="10" rx="2" />
                      <circle cx="5.8" cy="6.6" r="1.1" />
                      <path d="m3 12 3.6-3.4 2.4 2.2 1.8-1.6L14 12" />
                    </svg>
                  </span>
                  <span class="chat-model">
                    Sonnet
                    <svg
                      viewBox="0 0 16 16"
                      width="10"
                      height="10"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M3.5 10 8 5.5 12.5 10" />
                    </svg>
                  </span>
                  <span class="chat-send">
                    <svg
                      viewBox="0 0 14 14"
                      width="12"
                      height="12"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.9"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M7 12V2.5M3 6.5 7 2.5l4 4" />
                    </svg>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="feature-text">
          <h3>Chat</h3>
          <p>
            No coding agent? Describe a change in the Chat tab and Stylebot
            writes the CSS. Bring your own Claude, OpenAI or Gemini key. It
            stays in your browser.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .features {
    background: var(--surface);
  }

  .features-track {
    padding-bottom: 4px;
  }

  .feature {
    flex: 0 0 min(440px, 86%);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .feature-text {
    min-width: 0;
    padding: 0 4px;
  }

  .feature-text h3 {
    font: 600 20px/1.25 var(--display);
    letter-spacing: -0.015em;
    margin: 0 0 8px;
    color: var(--ink);
  }

  .feature-text p {
    font: 400 15px/1.6 var(--ui);
    color: var(--muted);
    margin: 0;
    max-width: 44ch;
    text-wrap: pretty;
  }

  .feature-mock {
    height: 400px;
    border-radius: 16px;
    background: var(--fill);
    border: 1px solid var(--border);
    display: grid;
    align-content: center;
    padding: 24px;
    overflow: hidden;
    color: var(--ink);
    font: 400 12.5px/1.4 var(--ui);
  }

  .feature-mock > [data-ed] {
    color: var(--ink);
  }

  .mock-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .mock-title {
    font: 600 14px/1.25 var(--ui);
    color: var(--ink);
  }

  .mock-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 13px;
    border-radius: 8px;
    border: 1px solid var(--strong);
    background: var(--surface);
    font: 600 12.5px/1 var(--ui);
    color: var(--ink);
  }

  .mock-link {
    font: 600 12.5px/1 var(--ui);
    color: var(--acc);
  }

  .muted {
    color: var(--muted);
  }

  .faint {
    color: var(--faint);
    flex: none;
  }

  .acc {
    color: var(--acc);
  }

  .sync-head {
    padding: 14px 16px;
    background: var(--fill);
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .sync-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 9px;
    border-radius: 12px;
    border: 1px solid #bfe3cc;
    background: #eef8f1;
    font: 600 11.5px/1 var(--ui);
    color: #1f7a45;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: #1f8a4c;
  }

  :global(:root:is([data-theme='dark'], [data-theme='stylebot'])) .sync-pill {
    border-color: #24563a;
    background: #173a24;
    color: #6fdd8b;
  }

  :global(:root:is([data-theme='dark'], [data-theme='stylebot'])) .dot {
    background: #4ac26b;
  }

  .sync-grid {
    padding: 14px 16px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 10px 14px;
  }

  .sync-path {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sync-schedule {
    grid-column: span 2;
  }

  .sync-status {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .sync-now {
    margin-left: auto;
  }

  .sync-file {
    grid-column: 2 / span 2;
    margin-top: -4px;
    font: 400 11px/1.4 var(--mono);
    color: var(--acc);
  }

  .hist-day {
    padding: 10px 16px;
    background: var(--fill);
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    line-height: 1.2;
  }

  .hist-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    font: 400 13px/1.2 var(--ui);
  }

  .hist-row.last {
    border-bottom: none;
  }

  .hist-row b {
    font-weight: 600;
  }

  .hist-time {
    width: 66px;
    flex: none;
    color: var(--muted);
  }

  .hist-what {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .hist-current {
    padding: 4px 9px;
    border-radius: 10px;
    border: 1px solid var(--accline);
    background: var(--acctint);
    font: 600 11.5px/1 var(--ui);
    color: var(--acc);
    flex: none;
  }

  .hist-chev {
    width: 52px;
    flex: none;
    display: flex;
    justify-content: flex-end;
    color: var(--faint);
  }

  .preset-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .preset {
    padding: 14px 16px;
  }

  .preset-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .preset-note {
    margin-left: auto;
    font: 400 12px/1 var(--ui);
    color: var(--muted);
  }

  .preset-body {
    margin-top: 8px;
    color: var(--muted);
    line-height: 1.5;
  }

  .switch {
    width: 36px;
    height: 20px;
    border-radius: 10px;
    flex: none;
    position: relative;
    background: var(--strong);
  }

  .switch > span {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
  }

  .switch.on {
    background: var(--acc);
  }

  .switch.on > span {
    left: 18px;
  }

  .chat-card {
    display: flex;
    flex-direction: column;
    background: var(--sunken);
  }

  .chat-thread {
    padding: 20px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .chat-msg {
    align-self: flex-end;
    max-width: 76%;
    padding: 9px 13px;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--ink) 9%, var(--sunken));
    background: color-mix(in srgb, var(--ink) 6%, var(--sunken));
    font: 400 14px/1.45 var(--ui);
    color: var(--ink);
    text-wrap: pretty;
  }

  .chat-reply {
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .chat-reply p {
    margin: 0;
    font: 400 14px/1.55 var(--ui);
    color: var(--ink2);
    text-wrap: pretty;
  }

  .chat-change {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 28px;
    margin: 0 -8px;
    padding: 3px 8px;
    font: 400 13px/1 var(--ui);
    color: var(--muted);
  }

  .chat-change > svg {
    display: block;
    flex: none;
  }

  .chat-change-label {
    font-weight: 500;
    color: var(--ink2);
    white-space: nowrap;
  }

  .chat-diff {
    margin-left: 2px;
    display: flex;
    flex: none;
    overflow: hidden;
    border-radius: 5px;
    font: 500 11px/1 var(--ui);
    font-variant-numeric: tabular-nums;
  }

  .chat-added {
    padding: 3px 5px;
    background: #e8f5ee;
    color: #1a7f4b;
  }

  :global(:root:is([data-theme='dark'], [data-theme='stylebot'])) .chat-added {
    background: #173a24;
    color: #6fdd8b;
  }

  .chat-diff-open {
    display: flex;
    align-items: center;
    padding: 3px;
    background: color-mix(in srgb, var(--ink) 6%, var(--sunken));
    color: var(--muted);
  }

  .chat-undo {
    margin-left: auto;
    display: flex;
    flex: none;
    align-items: center;
    gap: 6px;
    padding: 5px 9px;
    border: 1px solid var(--strong);
    border-radius: 7px;
    font: 400 12px/1 var(--ui);
    color: var(--ink2);
  }

  .chat-composer {
    padding: 0 12px 12px;
  }

  .chat-input {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px 8px 8px 12px;
    border: 1px solid var(--strong);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 1px 2px rgba(20, 30, 50, 0.04);
  }

  .chat-placeholder {
    min-height: 42px;
    font: 400 14px/1.5 var(--ui);
    color: var(--faint);
  }

  .chat-tools {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
  }

  .chat-attach {
    width: 26px;
    height: 26px;
    margin-left: -5px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chat-model {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 26px;
    margin-left: -6px;
    margin-right: auto;
    padding: 0 6px;
    font: 400 13px/1 var(--ui);
    white-space: nowrap;
  }

  .chat-send {
    width: 26px;
    height: 26px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    background: color-mix(in srgb, var(--faint) 55%, transparent);
    color: var(--surface);
  }
</style>
