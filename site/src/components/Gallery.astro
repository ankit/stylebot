---
import { Image, getImage } from 'astro:assets';
import CarouselNav from './CarouselNav.astro';
import SbIcon from './SbIcon';
import { Check, Copy } from './icons';
import { GALLERY } from '../lib/gallery';

const items = await Promise.all(
  GALLERY.map(async (item) => ({
    ...item,
    full: (
      await getImage({
        src: item.image,
        width: item.image.width,
        format: 'webp',
        quality: 90,
      })
    ).src,
  })),
);
---

<section id="gallery" class="section">
  <div class="section-inner">
    <div class="section-head">
      <div>
        <h2 class="section-title">What people make with it</h2>
        <p class="section-lede">Real sites, restyled with Stylebot.</p>
      </div>
      <CarouselNav target="gallery-track" label="example" />
    </div>
    <div id="gallery-track" class="carousel gallery-track">
      {items.map((item) => (
        <figure
          class="gallery-item"
          data-gallery={item.id}
          data-site={item.site}
          data-note={item.note}
        >
          <div class="gallery-shot">
            <button
              class="gallery-open"
              data-open
              data-full={item.full}
              aria-label={`Enlarge ${item.site}: ${item.name}`}
            >
              <Image
                src={item.image}
                widths={[480, 720, 960]}
                sizes="(min-width: 1180px) 265px, (min-width: 700px) 25vw, 240px"
                loading="eager"
                alt={`${item.site} restyled with Stylebot: ${item.name}`}
              />
            </button>
            {item.css && (
              <div class="gallery-actions">
                <button
                  class="gallery-action gallery-install"
                  data-install
                  title="Install in Stylebot"
                  aria-label={`Install ${item.name} in Stylebot`}
                >
                  <span class="gallery-action-idle">
                    <SbIcon size={13} />
                    Install
                  </span>
                  <span class="gallery-action-ok">
                    <Check size={12} />
                    Installed
                  </span>
                </button>
                <button
                  class="gallery-action gallery-copy"
                  data-copy
                  title="Copy CSS"
                  aria-label={`Copy CSS for ${item.name}`}
                >
                  <span class="gallery-action-idle">
                    <Copy />
                  </span>
                  <span class="gallery-action-ok">
                    <Check />
                  </span>
                </button>
              </div>
            )}
          </div>
          <figcaption class="gallery-caption">
            <span class="gallery-name">{item.name}</span>
            <span class="gallery-site">{item.site}</span>
          </figcaption>
          {item.css && <template data-css>{item.css}</template>}
        </figure>
      ))}
    </div>
  </div>
</section>

<dialog class="lightbox" aria-label="Restyled site">
  <div class="lightbox-body" data-close>
    <img class="lightbox-img" alt="" />
    <div class="lightbox-bar">
      <span class="lightbox-name"></span>
      <span class="lightbox-site"></span>
      <span class="lightbox-note" hidden></span>
      <button class="lightbox-install" data-lightbox-install hidden>
        Install
      </button>
      <button class="lightbox-copy" data-lightbox-copy>
        Copy CSS
      </button>
    </div>
  </div>
  <button class="lightbox-close" data-close aria-label="Close">
    <svg
      width="14"
      height="14"
      viewBox="0 0 14 14"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M2.5 2.5l9 9M11.5 2.5l-9 9"></path>
    </svg>
  </button>
</dialog>

<script>
  const COPIED_MS = 1600;
  let resetTimer: ReturnType<typeof setTimeout> | undefined;
  let lightboxItem: HTMLElement | null = null;

  const cssOf = (item: HTMLElement) =>
    item.querySelector<HTMLTemplateElement>('template[data-css]')!.content
      .textContent ?? '';

  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const area = document.createElement('textarea');
      area.value = text;
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.appendChild(area);
      area.select();
      document.execCommand('copy');
      area.remove();
    }
  }

  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const lightboxCopy = dialog.querySelector<HTMLButtonElement>(
    '[data-lightbox-copy]',
  )!;
  const lightboxInstall = dialog.querySelector<HTMLButtonElement>(
    '[data-lightbox-install]',
  )!;
  const gallery = document.getElementById('gallery')!;
  const INSTALL_TIMEOUT_MS = 5000;

  function markCopied(item: HTMLElement) {
    document
      .querySelectorAll('.gallery-item.is-copied')
      .forEach((el) => el.classList.remove('is-copied'));
    item.classList.add('is-copied');
    item.querySelector('[data-copy]')!.setAttribute('title', 'Copied');
    if (lightboxItem === item) lightboxCopy.textContent = 'Copied';
    clearTimeout(resetTimer);
    resetTimer = setTimeout(() => {
      item.classList.remove('is-copied');
      item.querySelector('[data-copy]')!.setAttribute('title', 'Copy CSS');
      lightboxCopy.textContent = 'Copy CSS';
    }, COPIED_MS);
  }

  async function copyItem(item: HTMLElement) {
    await copyText(cssOf(item));
    markCopied(item);
  }

  /*
   * Stylebot's content script on this site answers the ping, so the install
   * buttons only show when there's an extension to install into.
   */
  window.addEventListener('message', (e) => {
    if (e.source === window && e.data?.type === 'stylebot:pong') {
      gallery.classList.add('can-install');
      if (lightboxItem) show(lightboxItem);
    }
  });
  window.postMessage({ type: 'stylebot:ping' }, location.origin);

  /**
   * Asks Stylebot to add the item's css as a new profile for its site, and
   * resolves with the profile's name, or null if it wasn't installed.
   */
  function requestInstall(item: HTMLElement): Promise<string | null> {
    const id = crypto.randomUUID();

    return new Promise((resolve) => {
      const done = (name: string | null) => {
        window.removeEventListener('message', onMessage);
        clearTimeout(timer);
        resolve(name);
      };
      const onMessage = (e: MessageEvent) => {
        if (
          e.source === window &&
          e.data?.type === 'stylebot:installed' &&
          e.data.id === id
        ) {
          done(e.data.profileName ?? null);
        }
      };
      const timer = setTimeout(() => done(null), INSTALL_TIMEOUT_MS);

      window.addEventListener('message', onMessage);
      window.postMessage(
        {
          type: 'stylebot:install',
          id,
          url: item.dataset.site,
          name: item.querySelector('.gallery-name')!.textContent,
          css: cssOf(item),
        },
        location.origin,
      );
    });
  }

  function installLabel(item: HTMLElement) {
    if (item.dataset.installed) return `Installed as ${item.dataset.installed}`;
    if (item.dataset.installFailed) return 'Couldn’t install';
    return 'Install';
  }

  async function installItem(item: HTMLElement) {
    const name = await requestInstall(item);

    if (name) {
      item.dataset.installed = name;
      delete item.dataset.installFailed;
      item.classList.add('is-installed', 'is-just-installed');
      setTimeout(
        () => item.classList.remove('is-just-installed'),
        COPIED_MS,
      );
      item
        .querySelector('[data-install]')!
        .setAttribute('title', `Installed as ${name}`);
    } else {
      item.dataset.installFailed = 'true';
    }

    if (lightboxItem === item) lightboxInstall.textContent = installLabel(item);
  }

  const items = [...document.querySelectorAll<HTMLElement>('.gallery-item')];
  const fullSrc = (item: HTMLElement) =>
    item.querySelector<HTMLButtonElement>('[data-open]')!.dataset.full!;

  /**
   * Fetches the full-size screenshots once the gallery is near the viewport,
   * so opening one shows it immediately.
   */
  const preloaded = new Set<string>();
  function preload() {
    items.forEach((item) => {
      const src = fullSrc(item);
      if (preloaded.has(src)) return;
      preloaded.add(src);
      const img = new Image();
      img.decoding = 'async';
      img.src = src;
    });
  }
  new IntersectionObserver(
    (entries, observer) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      observer.disconnect();
      preload();
    },
    { rootMargin: '600px 0px' },
  ).observe(document.getElementById('gallery')!);

  function show(item: HTMLElement) {
    const img = dialog.querySelector<HTMLImageElement>('.lightbox-img')!;
    img.src = fullSrc(item);
    img.alt = item.querySelector('[data-open] img')!.getAttribute('alt') ?? '';
    dialog.querySelector('.lightbox-name')!.textContent =
      item.querySelector('.gallery-name')!.textContent;
    dialog.querySelector('.lightbox-site')!.textContent =
      item.querySelector('.gallery-site')!.textContent;
    lightboxItem = item;
    const note = item.dataset.note;
    const noteEl = dialog.querySelector<HTMLElement>('.lightbox-note')!;
    noteEl.textContent = note ?? '';
    noteEl.hidden = !note;
    lightboxCopy.hidden = !!note;
    lightboxInstall.hidden = !!note || !gallery.classList.contains('can-install');
    lightboxInstall.textContent = installLabel(item);
    lightboxCopy.textContent = item.classList.contains('is-copied')
      ? 'Copied'
      : 'Copy CSS';
  }

  items.forEach((item) => {
    item
      .querySelector('[data-copy]')
      ?.addEventListener('click', () => copyItem(item));
    item
      .querySelector('[data-install]')
      ?.addEventListener('click', () => installItem(item));
    item
      .querySelector<HTMLButtonElement>('[data-open]')!
      .addEventListener('click', () => {
        preload();
        show(item);
        dialog.showModal();
      });
  });

  dialog.addEventListener('keydown', (e) => {
    if (!lightboxItem || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight'))
      return;
    e.preventDefault();
    const dir = e.key === 'ArrowRight' ? 1 : -1;
    const next =
      (items.indexOf(lightboxItem) + dir + items.length) % items.length;
    show(items[next]);
  });

  lightboxInstall.addEventListener('click', (e) => {
    e.stopPropagation();
    if (lightboxItem && !lightboxItem.dataset.note) installItem(lightboxItem);
  });

  lightboxCopy.addEventListener('click', (e) => {
    e.stopPropagation();
    if (lightboxItem && !lightboxItem.dataset.note) copyItem(lightboxItem);
  });

  dialog.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target === dialog || target.closest('[data-close]')) dialog.close();
  });

  dialog.addEventListener('close', () => {
    lightboxItem = null;
  });
</script>

<style>
  .gallery-track {
    padding-bottom: 8px;
  }

  .gallery-item {
    flex: 0 0 max(240px, calc((100% - 72px) / 4));
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
  }

  .gallery-shot {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--fill);
    box-shadow: 0 8px 24px rgba(25, 27, 31, 0.08);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .gallery-shot:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgba(25, 27, 31, 0.14);
  }

  .gallery-open {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }

  .gallery-open img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  .gallery-actions {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 2;
    display: flex;
    gap: 6px;
  }

  .gallery-action {
    width: 28px;
    height: 28px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    border: none;
    cursor: pointer;
    backdrop-filter: blur(6px);
    background: rgba(20, 22, 26, 0.45);
    color: #fff;
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition:
      opacity 0.15s,
      transform 0.15s,
      background 0.15s;
  }

  .gallery-install {
    display: none;
    width: auto;
    padding: 0 10px 0 8px;
    font: 600 12px/1 var(--ui);
  }

  .gallery-install span {
    gap: 5px;
    align-items: center;
  }

  .can-install .gallery-install {
    display: flex;
  }

  .gallery-shot:hover .gallery-action,
  .gallery-action:focus-visible,
  .is-copied .gallery-copy,
  .is-just-installed .gallery-action {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .is-copied .gallery-copy,
  .is-installed .gallery-install {
    background: rgba(31, 138, 76, 0.85);
  }

  .gallery-action-idle,
  .gallery-action-ok {
    display: flex;
  }

  .gallery-action-ok,
  .is-copied .gallery-copy .gallery-action-idle,
  .is-installed .gallery-install .gallery-action-idle {
    display: none;
  }

  .is-copied .gallery-copy .gallery-action-ok,
  .is-installed .gallery-install .gallery-action-ok {
    display: flex;
  }

  .gallery-caption {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 0 2px;
    flex-wrap: wrap;
  }

  .gallery-name {
    font: 600 14px/1.3 var(--ui);
    color: var(--ink);
  }

  .gallery-site {
    font: 400 12.5px/1.3 var(--mono);
    color: var(--faint);
  }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 40px;
    border: none;
    background: transparent;
    cursor: zoom-out;
  }

  .lightbox::backdrop {
    background: rgba(12, 13, 16, 0.82);
    backdrop-filter: blur(6px);
  }

  .lightbox-body {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }

  .lightbox-img {
    width: min(1400px, 100%);
    max-height: calc(100vh - 140px);
    object-fit: contain;
    filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.5));
  }

  .lightbox-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    color: #fff;
  }

  .lightbox-name {
    font: 600 14px/1.3 var(--ui);
  }

  .lightbox-site {
    font: 400 12.5px/1.3 var(--mono);
    opacity: 0.7;
  }

  .lightbox-note {
    margin-left: 6px;
    font: 400 12.5px/1.3 var(--ui);
    opacity: 0.7;
  }

  .lightbox-install {
    margin-left: 6px;
    padding: 7px 12px;
    border-radius: 8px;
    border: none;
    background: var(--acc);
    color: #fff;
    cursor: pointer;
    font: 600 12.5px/1 var(--ui);
  }

  .lightbox-install:hover {
    filter: brightness(1.08);
  }

  .lightbox-copy {
    margin-left: 6px;
    padding: 7px 12px;
    border-radius: 8px;
    border: none;
    background: #fff;
    color: #191b1f;
    cursor: pointer;
    font: 600 12.5px/1 var(--ui);
  }

  .lightbox-copy:hover {
    background: #e9eaee;
  }

  .lightbox-close {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    border: none;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.24);
  }

  @media (max-width: 600px) {
    .lightbox {
      padding: 16px;
    }
  }
</style>
