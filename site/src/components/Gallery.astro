---
import { Image, getImage } from 'astro:assets';
import SbIcon from './SbIcon';
import { Check, Copy } from './icons';
import { GALLERY } from '../lib/gallery';
import { LINKS } from '../lib/links';

const SOURCE_BASE = `${LINKS.github}/blob/v4/site/src/assets/gallery/`;

const sites = await Promise.all(
  GALLERY.map(async (site) => ({
    ...site,
    themes: await Promise.all(
      site.themes.map(async (theme) => ({
        ...theme,
        full: (
          await getImage({
            src: theme.image,
            width: theme.image.width,
            format: 'webp',
            quality: 90,
          })
        ).src,
      })),
    ),
  })),
);
---

<section id="gallery" class="section">
  <div class="section-inner">
    <div class="section-head">
      <div>
        <h2 class="section-title">Styles to start from</h2>
        <p class="section-lede">
          Copy one and tweak it, or start from scratch.
        </p>
      </div>
    </div>
    <div class="gallery-grid">
      {sites.map((site) => (
        <figure
          class="gallery-item"
          data-gallery={site.id}
          data-site={site.url}
          data-active="0"
        >
          <span class="gallery-site">{site.site}</span>
          <div class="gallery-shot">
            {site.themes.map((theme, i) => (
              <button
                class="gallery-open"
                data-open
                data-theme={i}
                data-full={theme.full}
                hidden={i !== 0}
                aria-label={`Enlarge ${site.site}: ${theme.name}`}
              >
                <Image
                  src={theme.image}
                  widths={[480, 720, 960]}
                  sizes="(min-width: 1180px) 360px, (min-width: 700px) 45vw, 100vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  alt={`${site.site} restyled with Stylebot: ${theme.name}`}
                />
              </button>
            ))}
            <div class="gallery-actions">
              <button
                class="gallery-action gallery-install"
                data-install
                title="Install in Stylebot"
              >
                <span class="gallery-action-idle">
                  <SbIcon size={13} />
                  Install
                </span>
                <span class="gallery-action-ok">
                  <Check size={12} />
                  Installed
                </span>
              </button>
              <button
                class="gallery-action gallery-copy"
                data-copy
                title="Copy CSS"
                aria-label="Copy CSS"
              >
                <span class="gallery-action-idle">
                  <Copy />
                </span>
                <span class="gallery-action-ok">
                  <Check />
                </span>
              </button>
            </div>
          </div>
          <figcaption class="gallery-caption">
            <div class="gallery-chips">
              {site.themes.map((theme, i) => (
                <button
                  class="gallery-chip"
                  data-chip={i}
                  aria-pressed={i === 0}
                >
                  <span
                    class="gallery-dot"
                    style={`background: linear-gradient(135deg, ${theme.colors[0]} 0 50%, ${theme.colors[1]} 50% 100%)`}
                  />
                  <span class="gallery-name">{theme.name}</span>
                </button>
              ))}
            </div>
            <p class="gallery-hint">
              Paste it into the Code tab on {site.url}.
            </p>
          </figcaption>
          {site.themes.map((theme, i) => (
            <template
              data-theme-data={i}
              data-note={theme.note}
              data-source={theme.file && SOURCE_BASE + theme.file}
            >
              {theme.css}
            </template>
          ))}
        </figure>
      ))}
    </div>
  </div>
</section>

<dialog class="lightbox" aria-label="Restyled site">
  <div class="lightbox-body" data-close>
    <img class="lightbox-img" alt="" />
    <div class="lightbox-bar">
      <span class="lightbox-site"></span>
      <div class="lightbox-chips"></div>
      <span class="lightbox-note" hidden></span>
      <button class="lightbox-install" data-lightbox-install hidden>
        Install
      </button>
      <button class="lightbox-copy" data-lightbox-copy>
        Copy CSS
      </button>
      <a
        class="lightbox-source"
        data-lightbox-source
        target="_blank"
        rel="noopener"
        hidden
      >
        View on GitHub
      </a>
    </div>
  </div>
  <button class="lightbox-close" data-close aria-label="Close">
    <svg
      width="14"
      height="14"
      viewBox="0 0 14 14"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M2.5 2.5l9 9M11.5 2.5l-9 9"></path>
    </svg>
  </button>
</dialog>

<script>
  const COPIED_MS = 1600;
  const INSTALL_TIMEOUT_MS = 5000;
  let resetTimer: ReturnType<typeof setTimeout> | undefined;
  let lightboxItem: HTMLElement | null = null;

  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const lightboxCopy = dialog.querySelector<HTMLButtonElement>(
    '[data-lightbox-copy]',
  )!;
  const lightboxInstall = dialog.querySelector<HTMLButtonElement>(
    '[data-lightbox-install]',
  )!;
  const lightboxSource = dialog.querySelector<HTMLAnchorElement>(
    '[data-lightbox-source]',
  )!;
  const lightboxChips = dialog.querySelector<HTMLElement>('.lightbox-chips')!;
  const gallery = document.getElementById('gallery')!;
  const items = [...document.querySelectorAll<HTMLElement>('.gallery-item')];
  const installed = new Map<string, string>();
  const failed = new Set<string>();
  const copied = new Set<string>();

  const activeOf = (item: HTMLElement) => Number(item.dataset.active);
  const keyOf = (item: HTMLElement) =>
    `${item.dataset.gallery}:${activeOf(item)}`;
  const themeData = (item: HTMLElement) =>
    item.querySelector<HTMLTemplateElement>(
      `template[data-theme-data="${activeOf(item)}"]`,
    )!;
  const cssOf = (item: HTMLElement) =>
    themeData(item).content.textContent ?? '';
  const noteOf = (item: HTMLElement) => themeData(item).dataset.note;
  const nameOf = (item: HTMLElement) =>
    item.querySelectorAll('.gallery-name')[activeOf(item)].textContent ?? '';
  const siteOf = (item: HTMLElement) =>
    item.querySelector('.gallery-site')!.textContent ?? '';
  const fullSrc = (item: HTMLElement) =>
    item.querySelector<HTMLButtonElement>(
      `[data-open][data-theme="${activeOf(item)}"]`,
    )!.dataset.full!;

  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const area = document.createElement('textarea');
      area.value = text;
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.appendChild(area);
      area.select();
      document.execCommand('copy');
      area.remove();
    }
  }

  function installLabel(item: HTMLElement) {
    const name = installed.get(keyOf(item));
    if (name) return `Installed as ${name}`;
    if (failed.has(keyOf(item))) return 'Couldn’t install';
    return 'Install';
  }

  /**
   * Brings a card's buttons in line with its selected theme: which
   * screenshot shows, whether it has CSS to copy, and what is already done.
   */
  function render(item: HTMLElement) {
    const active = activeOf(item);
    const key = keyOf(item);
    const hasCss = !noteOf(item);
    item.querySelectorAll<HTMLElement>('[data-open]').forEach((el) => {
      el.hidden = Number(el.dataset.theme) !== active;
    });
    item.querySelectorAll<HTMLElement>('[data-chip]').forEach((el) => {
      el.setAttribute(
        'aria-pressed',
        String(Number(el.dataset.chip) === active),
      );
    });
    item.querySelector<HTMLElement>('.gallery-actions')!.hidden = !hasCss;
    item.classList.toggle('is-copied', copied.has(key));
    item.classList.toggle('is-installed', installed.has(key));
    item
      .querySelector('[data-copy]')!
      .setAttribute('title', copied.has(key) ? 'Copied' : 'Copy CSS');
    item
      .querySelector('[data-install]')!
      .setAttribute('title', installLabel(item));
    if (lightboxItem === item) renderLightbox(item);
  }

  function select(item: HTMLElement, index: number) {
    item.dataset.active = String(index);
    render(item);
  }

  function markCopied(item: HTMLElement) {
    const key = keyOf(item);
    copied.clear();
    copied.add(key);
    items.forEach(render);
    clearTimeout(resetTimer);
    resetTimer = setTimeout(() => {
      copied.delete(key);
      items.forEach(render);
    }, COPIED_MS);
  }

  async function copyItem(item: HTMLElement) {
    await copyText(cssOf(item));
    markCopied(item);
  }

  /*
   * Stylebot's content script on this site answers the ping, so the install
   * buttons only show when there's an extension to install into.
   */
  window.addEventListener('message', (e) => {
    if (e.source === window && e.data?.type === 'stylebot:pong') {
      gallery.classList.add('can-install');
      if (lightboxItem) renderLightbox(lightboxItem);
    }
  });
  window.postMessage({ type: 'stylebot:ping' }, location.origin);

  /**
   * Asks Stylebot to add the item's css as a new profile for its site, and
   * resolves with the profile's name, or null if it wasn't installed.
   */
  function requestInstall(item: HTMLElement): Promise<string | null> {
    const id = crypto.randomUUID();

    return new Promise((resolve) => {
      const done = (name: string | null) => {
        window.removeEventListener('message', onMessage);
        clearTimeout(timer);
        resolve(name);
      };
      const onMessage = (e: MessageEvent) => {
        if (
          e.source === window &&
          e.data?.type === 'stylebot:installed' &&
          e.data.id === id
        ) {
          done(e.data.profileName ?? null);
        }
      };
      const timer = setTimeout(() => done(null), INSTALL_TIMEOUT_MS);

      window.addEventListener('message', onMessage);
      window.postMessage(
        {
          type: 'stylebot:install',
          id,
          url: item.dataset.site,
          name: nameOf(item),
          css: cssOf(item),
        },
        location.origin,
      );
    });
  }

  async function installItem(item: HTMLElement) {
    const key = keyOf(item);
    const name = await requestInstall(item);

    if (name) {
      installed.set(key, name);
      failed.delete(key);
      item.classList.add('is-just-installed');
      setTimeout(() => item.classList.remove('is-just-installed'), COPIED_MS);
    } else {
      failed.add(key);
    }

    render(item);
  }

  /**
   * Fetches the full-size screenshots of each card's selected theme once the
   * gallery is near the viewport, so opening one shows it immediately.
   */
  const preloaded = new Set<string>();
  function preload(item?: HTMLElement) {
    (item ? [item] : items).forEach((el) => {
      const src = fullSrc(el);
      if (preloaded.has(src)) return;
      preloaded.add(src);
      const img = new Image();
      img.decoding = 'async';
      img.src = src;
    });
  }
  new IntersectionObserver(
    (entries, observer) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      observer.disconnect();
      preload();
    },
    { rootMargin: '600px 0px' },
  ).observe(gallery);

  function renderLightbox(item: HTMLElement) {
    const img = dialog.querySelector<HTMLImageElement>('.lightbox-img')!;
    const note = noteOf(item);
    const noteEl = dialog.querySelector<HTMLElement>('.lightbox-note')!;
    const key = keyOf(item);
    img.src = fullSrc(item);
    img.alt = `${siteOf(item)} restyled with Stylebot: ${nameOf(item)}`;
    dialog.querySelector('.lightbox-site')!.textContent = siteOf(item);
    const refocus = lightboxChips.contains(document.activeElement);
    lightboxChips.replaceChildren(
      ...[...item.querySelectorAll<HTMLElement>('[data-chip]')].map((chip) => {
        const copy = chip.cloneNode(true) as HTMLElement;
        copy.className = 'lightbox-chip';
        copy.querySelector('.gallery-dot')!.className = 'lightbox-dot';
        copy.querySelector('.gallery-name')!.className = 'lightbox-chip-name';
        return copy;
      }),
    );
    const source = themeData(item).dataset.source;
    lightboxSource.hidden = !source;
    if (source) lightboxSource.href = source;
    if (refocus) {
      lightboxChips
        .querySelectorAll<HTMLElement>('[data-chip]')
        [activeOf(item)]?.focus();
    }
    noteEl.textContent = note ?? '';
    noteEl.hidden = !note;
    lightboxCopy.hidden = !!note;
    lightboxInstall.hidden =
      !!note || !gallery.classList.contains('can-install');
    lightboxInstall.textContent = installLabel(item);
    lightboxCopy.textContent = copied.has(key) ? 'Copied' : 'Copy CSS';
  }

  function open(item: HTMLElement) {
    lightboxItem = item;
    preload(item);
    renderLightbox(item);
    if (!dialog.open) dialog.showModal();
  }

  items.forEach((item) => {
    item
      .querySelector('[data-copy]')!
      .addEventListener('click', () => copyItem(item));
    item
      .querySelector('[data-install]')!
      .addEventListener('click', () => installItem(item));
    item.querySelectorAll<HTMLElement>('[data-open]').forEach((el) => {
      el.addEventListener('click', () => open(item));
    });
    item.querySelectorAll<HTMLElement>('[data-chip]').forEach((chip) => {
      chip.addEventListener('click', () =>
        select(item, Number(chip.dataset.chip)),
      );
    });
    render(item);
  });

  lightboxChips.addEventListener('click', (e) => {
    e.stopPropagation();
    const chip = (e.target as HTMLElement).closest<HTMLElement>('[data-chip]');
    if (chip && lightboxItem) select(lightboxItem, Number(chip.dataset.chip));
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && dialog.open) dialog.close();
  });

  dialog.addEventListener('keydown', (e) => {
    if (!lightboxItem || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight'))
      return;
    e.preventDefault();
    const count = lightboxItem.querySelectorAll('[data-chip]').length;
    const dir = e.key === 'ArrowRight' ? 1 : -1;
    select(lightboxItem, (activeOf(lightboxItem) + dir + count) % count);
  });

  lightboxInstall.addEventListener('click', (e) => {
    e.stopPropagation();
    if (lightboxItem && !noteOf(lightboxItem)) installItem(lightboxItem);
  });

  lightboxCopy.addEventListener('click', (e) => {
    e.stopPropagation();
    if (lightboxItem && !noteOf(lightboxItem)) copyItem(lightboxItem);
  });

  dialog.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target === dialog || target.closest('[data-close]')) dialog.close();
  });

  dialog.addEventListener('close', () => {
    lightboxItem = null;
  });
</script>

<style>
  .gallery-grid {
    display: grid;
    gap: 40px 24px;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }

  .gallery-item {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
  }

  .gallery-shot {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--fill);
    box-shadow: 0 8px 24px rgba(25, 27, 31, 0.08);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .gallery-shot:has(.gallery-open:focus-visible) {
    outline: 2px solid var(--acc);
    outline-offset: 2px;
  }

  .gallery-shot:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgba(25, 27, 31, 0.14);
  }

  .gallery-open {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }

  .gallery-open:focus-visible {
    outline: none;
  }

  .gallery-open img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .gallery-open[hidden],
  .gallery-actions[hidden] {
    display: none;
  }

  .gallery-actions {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 2;
    display: flex;
    gap: 6px;
  }

  .gallery-action {
    width: 28px;
    height: 28px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    border: none;
    cursor: pointer;
    backdrop-filter: blur(6px);
    background: rgba(20, 22, 26, 0.45);
    color: #fff;
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition:
      opacity 0.15s,
      transform 0.15s,
      background 0.15s;
  }

  .gallery-install {
    display: none;
    width: auto;
    padding: 0 10px 0 8px;
    font: 600 12px/1 var(--ui);
  }

  .gallery-install span {
    gap: 5px;
    align-items: center;
  }

  .can-install .gallery-install {
    display: flex;
  }

  .gallery-shot:hover .gallery-action,
  .gallery-action:focus-visible,
  .is-copied .gallery-copy,
  .is-just-installed .gallery-action {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .is-copied .gallery-copy,
  .is-installed .gallery-install {
    background: rgba(31, 138, 76, 0.85);
  }

  .gallery-action-idle,
  .gallery-action-ok {
    display: flex;
  }

  .gallery-action-ok,
  .is-copied .gallery-copy .gallery-action-idle,
  .is-installed .gallery-install .gallery-action-idle {
    display: none;
  }

  .is-copied .gallery-copy .gallery-action-ok,
  .is-installed .gallery-install .gallery-action-ok {
    display: flex;
  }

  .gallery-caption {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 2px;
  }

  .gallery-site {
    font: 600 15px/1.3 var(--ui);
    color: var(--ink);
  }

  .gallery-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }

  .gallery-hint {
    min-height: 20px;
    margin: 0;
    font: 400 13px/1.4 var(--ui);
    color: var(--muted);
    visibility: hidden;
  }

  .is-copied .gallery-hint {
    visibility: visible;
  }

  .gallery-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 6px;
    margin: 0 -6px;
    border: none;
    border-radius: 7px;
    background: none;
    cursor: pointer;
    white-space: nowrap;
    font: 400 13px/1.2 var(--ui);
    color: var(--muted);
    transition: color 0.15s;
  }

  .gallery-chip:hover,
  .gallery-chip[aria-pressed='true'] {
    color: var(--ink);
  }

  .gallery-chip[aria-pressed='true'] .gallery-name {
    font-weight: 600;
  }

  .gallery-dot,
  .lightbox-dot {
    width: 10px;
    height: 10px;
    flex: none;
    border-radius: 5px;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.18);
  }

  .lightbox-dot {
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3);
  }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 40px;
    border: none;
    background: transparent;
    cursor: zoom-out;
  }

  .lightbox::backdrop {
    background: rgba(12, 13, 16, 0.82);
    backdrop-filter: blur(6px);
  }

  .lightbox-body {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }

  .lightbox-img {
    width: min(1400px, 100%);
    max-height: calc(100vh - 140px);
    object-fit: contain;
    filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.5));
  }

  .lightbox-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    color: #fff;
  }

  .lightbox-site {
    font: 500 13px/1.3 var(--ui);
    opacity: 0.7;
  }

  .lightbox-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 14px;
  }

  .lightbox-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    margin: 0 -8px;
    border: none;
    border-radius: 8px;
    background: none;
    cursor: pointer;
    white-space: nowrap;
    font: 400 14px/1.2 var(--ui);
    color: rgba(255, 255, 255, 0.6);
  }

  .lightbox-chip:hover {
    color: #fff;
  }

  .lightbox-chip:focus-visible {
    color: #fff;
  }

  .lightbox-chip[aria-pressed='true'] {
    color: #fff;
    font-weight: 600;
  }

  .lightbox-note {
    margin-left: 6px;
    font: 400 12.5px/1.3 var(--ui);
    opacity: 0.7;
  }

  .lightbox-install {
    margin-left: 6px;
    padding: 7px 12px;
    border-radius: 8px;
    border: none;
    background: var(--acc);
    color: #fff;
    cursor: pointer;
    font: 600 12.5px/1 var(--ui);
  }

  .lightbox-install:hover {
    filter: brightness(1.08);
  }

  .lightbox-copy {
    margin-left: 6px;
    padding: 7px 12px;
    border-radius: 8px;
    border: none;
    background: #fff;
    color: #191b1f;
    cursor: pointer;
    font: 600 12.5px/1 var(--ui);
  }

  .lightbox-copy:hover {
    background: #e9eaee;
  }

  .lightbox-source {
    margin-left: 4px;
    padding: 7px 4px;
    border-radius: 6px;
    color: rgba(255, 255, 255, 0.7);
    font: 500 12.5px/1 var(--ui);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(255, 255, 255, 0.35);
  }

  .lightbox-source[hidden] {
    display: none;
  }

  .lightbox-source:hover {
    color: #fff;
  }

  .lightbox-close {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    border: none;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.24);
  }

  @media (max-width: 600px) {
    .lightbox {
      padding: 16px;
    }
  }
</style>
