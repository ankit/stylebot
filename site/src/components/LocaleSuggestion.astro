---
import { LOCALES, messages } from '../i18n';

const strings = Object.fromEntries(
  LOCALES.map(({ code }) => {
    const { suggest, dismiss } = messages(code).site.header;
    return [code, { suggest, dismiss }];
  }),
);
---

<div class="locale-suggestion" data-strings={JSON.stringify(strings)} hidden>
  <a class="locale-suggestion-link"></a>
  <button class="locale-suggestion-close">
    <svg
      width="12"
      height="12"
      viewBox="0 0 14 14"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M2.5 2.5l9 9M11.5 2.5l-9 9"></path>
    </svg>
  </button>
</div>

<script>
  import {
    htmlLang,
    localeOf,
    localizePath,
    matchLocale,
    unlocalizedPath,
    type Locale,
  } from '../i18n/locales';
  import { LOCALE_CHOSEN_KEY } from '../lib/locale-choice';

  const bar = document.querySelector<HTMLElement>('.locale-suggestion')!;
  const strings: Record<Locale, { suggest: string; dismiss: string }> =
    JSON.parse(bar.dataset.strings!);

  let chosen: string | null = null;
  try {
    chosen = localStorage.getItem(LOCALE_CHOSEN_KEY);
  } catch {}

  const preferred = navigator.languages
    .map(matchLocale)
    .find((locale) => locale);
  const current = localeOf(location.pathname);

  if (!chosen && preferred && preferred !== current) {
    const link = bar.querySelector<HTMLAnchorElement>('a')!;
    const close = bar.querySelector<HTMLButtonElement>('button')!;
    link.textContent = strings[preferred].suggest;
    link.lang = htmlLang(preferred);
    link.href =
      localizePath(preferred, unlocalizedPath(location.pathname)) +
      location.hash;
    close.setAttribute('aria-label', strings[preferred].dismiss);
    bar.hidden = false;

    const remember = () => {
      try {
        localStorage.setItem(LOCALE_CHOSEN_KEY, '1');
      } catch {}
    };
    link.addEventListener('click', remember);
    close.addEventListener('click', () => {
      remember();
      bar.hidden = true;
    });
  }
</script>

<style>
  .locale-suggestion {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 8px 16px;
    background: var(--acctint);
    border-bottom: 1px solid var(--accline);
    font: 500 13.5px/1.3 var(--ui);
  }

  .locale-suggestion[hidden] {
    display: none;
  }

  .locale-suggestion-link {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .locale-suggestion-close {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .locale-suggestion-close:hover {
    background: var(--hover);
    color: var(--ink);
  }
</style>
