---
import Base from '../layouts/Base.astro';
import Demo from '../components/demo/Demo';
import Gallery from '../components/Gallery.astro';
import Features from '../components/Features.astro';
import CliCommand from '../components/cli/CliCommand.astro';
import CliSection from '../components/cli/CliSection.astro';
import Quotes from '../components/Quotes.astro';
import Footer from '../components/Footer.astro';
import StoreLink from '../components/StoreLink.astro';
import { CLI_PACKAGE, LINKS, STORES } from '../lib/links';
import { SITE_DESCRIPTION } from '../lib/site';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Stylebot',
  url: Astro.site?.href,
  description: SITE_DESCRIPTION,
  applicationCategory: 'BrowserApplication',
  operatingSystem: 'Chrome, Firefox, Edge',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  downloadUrl: Object.values(STORES).map((store) => store.href),
  sameAs: [LINKS.github, ...Object.values(STORES).map((store) => store.href)],
  author: { '@type': 'Person', name: 'Ankit Ahuja', url: LINKS.author },
};
---

<Base footer={false} storeCta>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@1&family=JetBrains+Mono:wght@500&family=Silkscreen&family=Libre+Caslon+Text:wght@700&display=swap&text=Restyle"
    rel="stylesheet"
  />
  <main>
    <div class="hero">
      <h1>
        <button class="restyle" type="button" title="Click to restyle">
          Restyle
          <span class="restyle-cycle" aria-hidden="true">
            Restyle
          </span>
        </button>{' '}
        any website.
      </h1>
      <p>
        Point at something on the page and change it, or just describe what you
        want. Stylebot writes the CSS and loads your style every time you come
        back.
      </p>
      <div class="cta">
        <div class="cta-row">
          <StoreLink index={0} format="add-free" class="btn btn-primary" />
          <span class="cta-also">
            Also on <StoreLink index={1} format="name" class="ink-link" /> and{' '}
            <StoreLink index={2} format="name" class="ink-link" />
          </span>
        </div>
      </div>
    </div>

    <div class="demo-wrap">
      <Demo client:visible />
    </div>

    <CliSection />
    <Gallery />
    <Features />
    <Quotes />

    <section id="install" class="section">
      <div class="install">
        <h2>Install Stylebot</h2>
        <p>
          Free and open source since 2011. No account and no tracking. Your
          styles live in your browser, and the code is on GitHub.
        </p>
        <div class="install-buttons">
          <StoreLink index={0} format="add" class="btn btn-primary" />
          <StoreLink index={1} format="name" class="btn btn-outline" />
          <StoreLink index={2} format="name" class="btn btn-outline" />
        </div>
        <div class="install-cli">
          <span>
            Using a coding agent? Add the <a href="#cli">CLI</a>:
          </span>
          <CliCommand lines={[`npm install -g ${CLI_PACKAGE}`]} boxed />
        </div>
        <Footer />
      </div>
    </section>
  </main>
</Base>

<script>
  const STEPS = 5;
  const PLAY = [0, 350, 700, 1050, 1450];

  for (const font of [
    "italic 1em 'DM Serif Display'",
    "500 1em 'JetBrains Mono'",
    '1em Silkscreen',
    "700 1em 'Libre Caslon Text'",
  ]) {
    document.fonts.load(font, 'Restyle');
  }

  const button = document.querySelector<HTMLButtonElement>('.restyle')!;
  const word = button.querySelector<HTMLElement>('.restyle-cycle')!;
  let step = 0;
  let timers: number[] = [];

  function show(next: number) {
    step = next;
    word.dataset.step = String(step);
  }

  function stopPlaying() {
    timers.forEach(clearTimeout);
    timers = [];
    delete word.dataset.playing;
  }

  button.addEventListener('click', () => {
    stopPlaying();
    show((step + 1) % STEPS);
  });

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    timers = PLAY.map((at, i) =>
      window.setTimeout(() => {
        const last = i === PLAY.length - 1;
        word.toggleAttribute('data-playing', !last);
        show(last ? 0 : i + 1);
      }, 400 + at),
    );
  }
</script>

<style>
  .hero {
    max-width: 760px;
    margin: 0 auto;
    padding: 64px 24px 36px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .hero h1 {
    font: 700 clamp(36px, 5.4vw, 58px) / 1.04 var(--display);
    letter-spacing: -0.035em;
    margin: 0;
    text-wrap: balance;
  }

  .restyle {
    position: relative;
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    color: transparent;
    cursor: pointer;
  }

  .restyle:focus-visible {
    outline: none;
  }

  .restyle-cycle {
    position: absolute;
    right: -4px;
    top: 50%;
    translate: 0 -50%;
    padding: 0 4px;
    border-radius: 4px;
    color: var(--ink);
    white-space: nowrap;
    user-select: none;
    pointer-events: none;
    outline: 1.5px dashed transparent;
    outline-offset: 4px;
  }

  .restyle:hover .restyle-cycle,
  .restyle:focus-visible .restyle-cycle,
  .restyle-cycle[data-playing] {
    outline-color: color-mix(in srgb, var(--acc) 45%, transparent);
  }

  .restyle-cycle[data-step='1'] {
    translate: 0 calc(-50% + 0.027em);
    font-family: 'DM Serif Display', serif;
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--acc);
  }

  .restyle-cycle[data-step='2'] {
    translate: 0 calc(-50% + 0.034em);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.94em;
    font-weight: 500;
    letter-spacing: -0.06em;
    color: #191b1f;
    background: #fde68a;
  }

  .restyle-cycle[data-step='3'] {
    translate: 0 calc(-50% + 0.15em);
    font-family: 'Silkscreen', monospace;
    font-size: 0.72em;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--acc);
    background: var(--accline);
  }

  .restyle-cycle[data-step='4'] {
    translate: 0 calc(-50% + 0.039em);
    font-family: 'Libre Caslon Text', serif;
    font-size: 0.95em;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #191b1f;
    background: #e7e4dc;
  }

  .hero p {
    font: 400 18px/1.55 var(--ui);
    color: var(--muted);
    margin: 0;
    max-width: 48ch;
    text-wrap: pretty;
  }

  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .cta-also {
    font: 400 13px/1.4 var(--ui);
    color: var(--muted);
  }

  .cta-also :global(.ink-link) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--strong);
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
  }

  .cta-also :global(.ink-link:hover) {
    color: var(--link, var(--ink));
    text-decoration-color: var(--ink);
  }

  .demo-wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px 88px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .install {
    max-width: 1180px;
    margin: 0 auto;
    padding: 80px 24px 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .install h2 {
    font: 700 clamp(28px, 3.4vw, 40px) / 1.1 var(--display);
    letter-spacing: -0.03em;
    margin: 0;
  }

  .install p {
    font: 400 16px/1.55 var(--ui);
    color: var(--muted);
    margin: 0;
    max-width: 52ch;
  }

  .install-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }

  .install-cli {
    margin-top: 10px;
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font: 400 14px/1.4 var(--ui);
    color: var(--muted);
  }

  .install-cli a {
    color: var(--link, var(--ink));
  }

  .install :global(.site-footer) {
    width: 100%;
  }

  @media (max-width: 600px) {
    .hero {
      padding-top: 56px;
    }

    .demo-wrap {
      padding-bottom: 64px;
    }
  }
</style>
