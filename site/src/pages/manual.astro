---
import Base from '../layouts/Base.astro';
import ImageZoom from '../components/ImageZoom.astro';
import Callout from '../components/manual/Callout.astro';
import Keys from '../components/manual/Keys.astro';
import Shot from '../components/manual/Shot.astro';
import Term from '../components/manual/Term.astro';
import Terms from '../components/manual/Terms.astro';
import chatShot from '../assets/manual/chat.webp';
import chatDarkShot from '../assets/manual/chat-dark.webp';
import basicShot from '../assets/manual/basic-editor.webp';
import basicDarkShot from '../assets/manual/basic-editor-dark.webp';
import popupProfilesShot from '../assets/manual/popup-profiles.png';
import popupProfilesDarkShot from '../assets/manual/popup-profiles-dark.png';
import syncShot from '../assets/manual/sync.png';
import syncDarkShot from '../assets/manual/sync-dark.png';
import historyShot from '../assets/manual/history.png';
import historyDarkShot from '../assets/manual/history-dark.png';
import readabilityShot from '../assets/manual/readability.webp';
import readabilityDarkShot from '../assets/manual/readability-dark.webp';
import { LINKS } from '../lib/links';

const toc = [
  ['start', 'Getting started'],
  ['profiles', 'Profiles'],
  ['cli', 'Command line'],
  ['chat', 'Chat'],
  ['presets', 'Readability and grayscale'],
  ['sync', 'Sync, backup and history'],
  ['urls', 'URL rules'],
  ['shortcuts', 'Keyboard shortcuts'],
  ['help', 'Help and support'],
];

const wildcards = [
  ['**', 'Matches any character sequence.'],
  ['*', 'Matches any character sequence until a / is found.'],
  [',', 'Separates a list of patterns. A URL matches if any pattern matches.'],
  ['^', 'At the start of a URL, turns it into a regular expression.'],
];

const examples = [
  ['docs.google.com', 'The domain docs.google.com or any of its subdomains.'],
  ['docs**', 'Any URL beginning with docs.'],
  [
    'docs*.google.com',
    'docs.google.com, docs1.google.com, docs2.google.com and so on.',
  ],
  ['*.ycombinator.com', 'news.ycombinator.com and apps.ycombinator.com.'],
  [
    'docs.google.com, spreadsheets.google.com',
    'Either domain, or any of their subdomains.',
  ],
  ['^http://www.reddit.com/$', 'The Reddit homepage only.'],
  ['*', 'Every site. Useful for styles you want everywhere.'],
];

type Shortcut = [string, string[] | null, string?];

const globalShortcuts: Shortcut[] = [
  ['Toggle editor', ['alt', 'shift', 'M']],
  ['Toggle styling', ['alt', 'shift', 'S']],
  ['Toggle readability', null],
  ['Toggle grayscale', null],
];

const editorShortcuts: Shortcut[] = [
  ['Element picker', ['I']],
  ['Hide selected elements', ['H']],
  ['Basic tab', ['B']],
  ['Code tab', ['C']],
  ['Presets tab', ['P']],
  ['Chat tab', ['T']],
  ['Open in the side panel', ['S']],
  ['Open in a separate window', ['W']],
  ['Dock left or right in the page', ['L', 'R'], 'or'],
  ['Undo', ['ctrl', 'Z']],
  ['Redo', ['ctrl', 'shift', 'Z']],
  ['Show shortcuts', ['?']],
];

const pickerShortcuts: Shortcut[] = [
  ['Select the parent element', ['↑', '←'], 'or'],
  ['Go back to the child element', ['↓', '→'], 'or'],
  ['Select the highlighted element', ['enter']],
];

const shortcutGroups = [
  { title: 'Global', rows: globalShortcuts },
  { title: 'In the editor', rows: editorShortcuts },
  { title: 'While picking an element', rows: pickerShortcuts },
];
---

<Base
  title="Manual"
  description="How to use Stylebot: styling a site, profiles, the command line, Chat, sync, URL rules and shortcuts."
  current="manual"
>
  <div class="manual">
    <div class="manual-intro">
      <h1>Manual</h1>
      <p>
        How Stylebot works, from your first style to profiles, Chat and sync.
      </p>
    </div>

    <div class="manual-body">
      <nav class="toc" aria-label="Manual sections">
        {toc.map(([id, label], i) => (
          <a
            href={`#${id}`}
            data-toc={id}
            class:list={{ 'is-active': i === 0 }}
          >
            {label}
          </a>
        ))}
      </nav>

      <main class="sections">
        <section id="start">
          <h2>Getting started</h2>
          <p>
            Click the Stylebot icon in the toolbar, then{' '}
            <strong>Style this page</strong>. Or press{' '}
            <Keys keys={['alt', 'shift', 'M']} /> on any tab, or right-click an
            element and choose <strong>Stylebot → Style Element</strong>.
          </p>
          <Shot
            label="The Basic tab, picking a link in a Wikipedia article"
            src={basicShot}
            dark={basicDarkShot}
          />
          <p>
            Click the picker, hover the page and click an element. Press{' '}
            <Keys keys={['↑']} /> before clicking to select its parent instead.
            Then change it in <strong>Basic</strong>, or write CSS in{' '}
            <strong>Code</strong>. Changes save as you make them and load every
            time you visit the site.
          </p>
          <Terms>
            <Term term="Fonts">
              Search 400 <a href="https://fonts.google.com/">Google Fonts</a>{' '}
              and Stylebot loads the one you pick, or type any font installed on
              your computer.
            </Term>
            <Term term="Editor position">
              In Chrome and Edge the editor opens in the side panel. Use{' '}
              <strong>Position</strong> in its <strong>⋯</strong> menu to open
              it in a separate window or dock it in the page. Firefox has no
              side panel.
            </Term>
            <Term term="Turning a style off">
              Use the switch in the popup, or{' '}
              <Keys keys={['alt', 'shift', 'S']} />. The style is kept, just not
              applied.
            </Term>
          </Terms>
          <Callout>
            Some sites use auto-generated class names that change when the site
            updates. If a style stops working, pick the element again to get a
            fresh selector.
          </Callout>
        </section>

        <section id="profiles">
          <h2>Profiles</h2>
          <p>
            A profile is a separate stylesheet for the same site, so you can
            keep more than one look and switch between them. Only one is applied
            at a time, and every site starts with Default.
          </p>
          <Shot
            label="The popup on Hacker News with four profiles: Violet Hour, Everforest, Hearth and Newspaper"
            src={popupProfilesShot}
            dark={popupProfilesDarkShot}
          />
          <p>
            Click the profile name next to the site in the editor's header to
            create, rename, duplicate or delete profiles. Switch between them
            there or in the popup, where <strong>No style</strong> turns styling
            off for the site. New profiles start empty.
          </p>
        </section>

        <section id="cli">
          <h2>Command line</h2>
          <p>
            The <code>stylebot</code> command lets a coding agent like Claude
            Code, Codex or Cursor restyle sites right in your browser, using
            your own subscription instead of an API key. It's the best way to
            have an agent style a site, and you can run the commands yourself
            too.
          </p>
          <Terms>
            <Term term="Setup">
              Install the CLI, connect it to your browsers, then turn on{' '}
              <strong>Let apps on this computer control Stylebot</strong> in
              Options. The <a href={LINKS.cli}>command line page</a> walks
              through each step. Chrome and Edge only for now.
            </Term>
            <Term term="Claude Code">
              Add the Stylebot plugin and ask for a change with{' '}
              <code>/stylebot</code>, such as a dark theme for a site.
            </Term>
            <Term term="Privacy">
              Command line access is off until you turn it on. Stylebot and the
              CLI talk only to each other, on this computer; an agent sends what
              it reads to its own provider.
            </Term>
          </Terms>
        </section>

        <section id="chat">
          <h2>Chat</h2>
          <p>
            Chat is ideal for quick fixes. Describe the change you want in the
            Chat tab and Stylebot writes the CSS. You can pick an element to
            point it at something, or attach a screenshot to show what you mean.
            For bigger changes, like a whole new theme, use the{' '}
            <a href="#cli">command line</a>.
          </p>
          <Shot
            label="The Chat tab after asking for a forest theme with a readable serif font on Hacker News"
            src={chatShot}
            dark={chatDarkShot}
          />
          <Terms>
            <Term term="Bring your own key">
              Connect a Claude, OpenAI or Gemini API key. Keys are saved on this
              computer only and never synced. Messages go straight from your
              browser to the provider.
            </Term>
            <Term term="Where changes go">
              Each change is applied right away and added to the current
              profile's stylesheet. Click <strong>Added N lines</strong> to see
              it in Code, or undo it from the chat.
            </Term>
            <Term term="Cost">
              The token count under the message box shows what the conversation
              has used, with an estimated cost.
            </Term>
          </Terms>
        </section>

        <section id="presets">
          <h2>Readability and grayscale</h2>
          <p>
            Both are in the Presets tab and stack with your own changes.{' '}
            <strong>Readability</strong> turns a site's articles into a clean
            reading view, with a choice of theme, font, size and width; it
            leaves pages that aren't articles alone. <strong>Grayscale</strong>{' '}
            removes color from the site, at any strength.
          </p>
          <Shot
            label="The Wikipedia article on Mathematics in the Readability view, with Reading settings open"
            src={readabilityShot}
            dark={readabilityDarkShot}
          />
        </section>

        <section id="sync">
          <h2>Sync, backup and history</h2>
          <Shot
            label="Options, connected to Google Drive and synced"
            src={syncShot}
            dark={syncDarkShot}
          />
          <Terms>
            <Term term="Google Drive sync">
              Connect Google Drive in Options. Your styles, including profiles,
              sync every 30 minutes and right after you edit. Stylebot only sees
              the files it creates in your Drive, and there is no Stylebot
              server.
            </Term>
            <Term term="Conflicts">
              If a style changed on two computers, your newer edit is kept and
              the other version is saved in a comment, so nothing is lost.
            </Term>
            <Term term="Backup">
              Export and import all your styles as JSON from Options.
            </Term>
            <Term term="Version history">
              Every change on this computer is kept in Options, including ones
              that arrive through sync. Restore any earlier version, for some
              sites or all of them.
            </Term>
          </Terms>
          <Shot
            label="Version history in Options, newest change first"
            src={historyShot}
            dark={historyDarkShot}
          />
        </section>

        <section id="urls">
          <h2>URL rules</h2>
          <p>
            By default, Stylebot matches styles to websites by domain name. Edit
            a style's URL in Options and use these patterns for anything more
            specific.
          </p>
          <div class="table">
            {wildcards.map(([pattern, meaning]) => (
              <div class="table-row">
                <span class="wildcard">
                  <code>{pattern}</code>
                </span>
                <span>{meaning}</span>
              </div>
            ))}
          </div>
          <h3>Examples</h3>
          <Terms>
            {examples.map(([pattern, meaning]) => (
              <Term>
                <code slot="term">{pattern}</code>
                {meaning}
              </Term>
            ))}
          </Terms>
        </section>

        <section id="shortcuts">
          <h2>Keyboard shortcuts</h2>
          <p>
            Global shortcuts work on any page Stylebot can style; change them in
            your browser's shortcut settings, linked from Options. Editor
            shortcuts work while focus isn't in a text field. Press{' '}
            <Keys keys={['?']} /> in the editor to see this list.
          </p>
          {shortcutGroups.map((group) => (
            <div class="table">
              <div class="table-head">{group.title}</div>
              {group.rows.map(([action, keys, sep]) => (
                <div class="table-row shortcut">
                  <span class="shortcut-action">{action}</span>
                  {keys ? (
                    <Keys keys={keys} sep={sep} />
                  ) : (
                    <span class="shortcut-unset">
                      Not set; assign in your browser
                    </span>
                  )}
                </div>
              ))}
            </div>
          ))}
        </section>

        <section id="help">
          <h2>Help and support</h2>
          <p>
            Found a bug or have an idea? Open an issue on{' '}
            <a href={LINKS.issues}>GitHub</a>. Stylebot is free and open source,
            maintained since 2011. If it's useful to you, you can support it by{' '}
            <a href={LINKS.donate}>buying me a coffee</a>.
          </p>
        </section>
      </main>
    </div>
  </div>
  <ImageZoom />
</Base>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  const sections = links
    .map((link) => document.getElementById(link.dataset.toc!))
    .filter((el): el is HTMLElement => !!el);

  function setActive(id: string) {
    links.forEach((link) =>
      link.classList.toggle('is-active', link.dataset.toc === id),
    );
  }

  function onScroll() {
    let current = sections[0]?.id;
    for (const section of sections) {
      if (section.getBoundingClientRect().top < 140) current = section.id;
    }
    if (current) setActive(current);
  }

  links.forEach((link) =>
    link.addEventListener('click', () => setActive(link.dataset.toc!)),
  );
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .manual {
    max-width: 1180px;
    margin: 0 auto;
    padding: 64px 24px 0;
  }

  .manual-intro {
    max-width: 720px;
    margin-bottom: 36px;
  }

  .manual-intro h1 {
    margin: 0 0 12px;
    font: 700 clamp(34px, 4.6vw, 48px) / 1.05 var(--display);
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .manual-intro p {
    margin: 0;
    font: 400 18px/1.55 var(--ui);
    color: var(--muted);
  }

  .manual-body {
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: flex-start;
  }

  .toc {
    flex: 0 0 220px;
    position: sticky;
    top: 84px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc a {
    display: block;
    padding: 7px 12px;
    border-radius: 8px;
    font: 400 14px/1.3 var(--ui);
    color: var(--muted);
  }

  .toc a:hover {
    background: var(--hover);
    color: var(--ink);
  }

  .toc a.is-active {
    font-weight: 600;
    color: var(--ink);
    background: var(--fill);
  }

  .sections {
    flex: 1 1 480px;
    min-width: 0;
    max-width: 720px;
  }

  section {
    scroll-margin-top: 88px;
    padding: 44px 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  h2 {
    margin: 0;
    font: 700 26px/1.2 var(--display);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  h3 {
    margin: 10px 0 0;
    font: 600 16px/1.3 var(--ui);
    color: var(--ink);
  }

  p {
    margin: 0;
    font: 400 16px/1.65 var(--ui);
    color: var(--ink2);
    text-wrap: pretty;
  }

  .sections :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .sections :global(code) {
    padding: 1px 6px;
    border-radius: 5px;
    background: var(--fill);
    border: 1px solid var(--border);
    font: 400 0.88em/1.5 var(--mono);
    color: var(--ink);
  }

  .sections :global(.keys) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }

  .sections :global(kbd) {
    display: inline-block;
    padding: 2px 7px;
    border-radius: 5px;
    background: var(--fill);
    border: 1px solid var(--strong);
    border-bottom-width: 2px;
    font: 500 12px/1.4 var(--mono);
    color: var(--ink2);
  }

  .sections :global(.keys-sep) {
    font: 400 12px/1 var(--ui);
    color: var(--faint);
  }

  .sections :global(.callout) {
    display: flex;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 10px;
    background: var(--fill);
    border: 1px solid var(--border);
    font: 400 14.5px/1.55 var(--ui);
    color: var(--ink2);
    text-wrap: pretty;
  }

  .sections :global(.callout-icon) {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 1px;
    border-radius: 9px;
    background: var(--muted);
    color: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 700 11px/1 system-ui;
  }

  .sections :global(.shot) {
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    border: 1px dashed var(--strong);
    background: var(--fill);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    text-align: center;
    font: 400 13px/1.5 var(--mono);
    color: var(--faint);
  }

  .sections :global(.shot-image) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--border);
    box-shadow: 0 8px 24px rgba(25, 27, 31, 0.08);
  }

  .sections :global(.terms) {
    margin: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }

  .sections :global(.term) {
    display: grid;
    grid-template-columns: minmax(0, 180px) minmax(0, 1fr);
    gap: 8px 24px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }

  .sections :global(.terms:last-child > .term:last-child) {
    border-bottom: none;
  }

  .sections :global(.term dt) {
    font: 600 14.5px/1.5 var(--ui);
    color: var(--ink);
  }

  .sections :global(.term dd) {
    margin: 0;
    font: 400 15px/1.6 var(--ui);
    color: var(--ink2);
    text-wrap: pretty;
  }

  .table {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface);
  }

  .table-head {
    padding: 10px 16px;
    background: var(--fill);
    border-bottom: 1px solid var(--border);
    font: 600 12px/1 var(--ui);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .table-row {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 12px 16px;
    font: 400 15px/1.55 var(--ui);
    color: var(--ink2);
  }

  .table-row + .table-row {
    border-top: 1px solid var(--border);
  }

  .wildcard {
    width: 44px;
    flex: none;
  }

  .shortcut {
    align-items: center;
    padding: 11px 16px;
  }

  .shortcut-action {
    flex: 1;
    font: 400 15px/1.4 var(--ui);
    color: var(--ink);
  }

  .shortcut-unset {
    font: 400 13px/1 var(--ui);
    color: var(--faint);
  }

  @media (max-width: 760px) {
    .manual {
      padding-top: 40px;
    }

    .manual-body {
      gap: 24px;
    }

    .toc {
      position: static;
      flex: 1 1 100%;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 6px;
    }

    .toc a {
      border: 1px solid var(--border);
      background: var(--surface);
    }

    .sections :global(.term) {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>
