---
import Base from '../layouts/Base.astro';
import NotFound from '../components/NotFound';
---

<Base title="Page not found" description="This page doesn't exist." noindex>
  <main class="nf-wrap">
    <NotFound client:load />
  </main>
</Base>

<style is:global>
  .nf-wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 56px 24px 0;
  }

  .nf-intro {
    max-width: 640px;
    margin-bottom: 28px;
  }


  .nf-intro h1 {
    margin: 0;
    font: 700 clamp(26px, 3.2vw, 34px) / 1.15 var(--display);
    letter-spacing: -0.025em;
    color: var(--ink);
    text-wrap: balance;
  }



  .nf-window {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 18px 44px rgba(25, 27, 31, 0.1);
  }

  .nf-chrome {
    height: 36px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 12px;
    background: var(--fill);
    border-bottom: 1px solid var(--border);
  }

  .nf-lights {
    display: flex;
    gap: 5px;
  }

  .nf-lights span {
    width: 9px;
    height: 9px;
    border-radius: 5px;
    background: var(--strong);
  }

  .nf-url {
    flex: 1;
    max-width: 320px;
    height: 22px;
    border-radius: 11px;
    background: var(--surface);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    padding: 0 10px;
    font: 400 11px/1 var(--mono);
    color: var(--muted);
    overflow: hidden;
    white-space: nowrap;
  }

  .nf-page {
    min-height: 420px;
    display: flex;
  }

  .nf-hr {
    margin: 16px 0 6px;
    border: none;
    border-top: 1px solid #aaa;
  }

  .nf-addr {
    font:
      italic 400 15px/1.3 'Times New Roman',
      Times,
      serif;
    color: #000;
  }

  .nf-nice {
    margin-top: 20px;
    height: 40px;
    padding: 0 18px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: #191b1f;
    color: #fff;
    cursor: pointer;
    font: 600 13.5px/1 var(--ui);
  }

  .nf-done {
    margin: 20px 0 0;
    min-height: 40px;
    display: flex;
    align-items: center;
    font: 400 16px/1.55 var(--ui);
    color: var(--muted);
  }

  .nf-nice:hover {
    background: #3f4550;
  }
</style>
