---
import Base from '../../layouts/Base.astro';
import ImageZoom from '../../components/ImageZoom.astro';
import Callout from '../../components/manual/Callout.astro';
import Keys from '../../components/manual/Keys.astro';
import Shot from '../../components/manual/Shot.astro';
import Term from '../../components/manual/Term.astro';
import Terms from '../../components/manual/Terms.astro';
import chatShot from '../../assets/manual/chat.webp';
import chatDarkShot from '../../assets/manual/chat-dark.webp';
import basicShot from '../../assets/manual/basic-editor.webp';
import basicDarkShot from '../../assets/manual/basic-editor-dark.webp';
import popupProfilesShot from '../../assets/manual/popup-profiles.png';
import popupProfilesDarkShot from '../../assets/manual/popup-profiles-dark.png';
import syncShot from '../../assets/manual/sync.png';
import syncDarkShot from '../../assets/manual/sync-dark.png';
import historyShot from '../../assets/manual/history.png';
import historyDarkShot from '../../assets/manual/history-dark.png';
import readabilityShot from '../../assets/manual/readability.webp';
import readabilityDarkShot from '../../assets/manual/readability-dark.webp';
import { LINKS } from '../../lib/links';
import { localeStaticPaths, localizePath, messagesFor, rich } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const {
  locale,
  site: { manual: t },
} = messagesFor(Astro.url);
const a = t.shortcuts.actions;

const toc = Object.entries(t.toc);

const wildcards = [
  ['**', t.urls.wildcards.anything],
  ['*', t.urls.wildcards.segment],
  [',', t.urls.wildcards.list],
  ['^', t.urls.wildcards.regex],
];

const examples = [
  ['docs.google.com', t.urls.examples.domain],
  ['docs**', t.urls.examples.prefix],
  ['docs*.google.com', t.urls.examples.numbered],
  ['*.ycombinator.com', t.urls.examples.subdomains],
  ['docs.google.com, spreadsheets.google.com', t.urls.examples.either],
  ['^http://www.reddit.com/$', t.urls.examples.regex],
  ['*', t.urls.examples.everywhere],
];

type Shortcut = [string, string[] | null, string?];

const globalShortcuts: Shortcut[] = [
  [a.toggleEditor, ['alt', 'shift', 'M']],
  [a.toggleStyling, ['alt', 'shift', 'S']],
  [a.toggleReadability, null],
  [a.toggleGrayscale, null],
];

const pickerShortcuts: Shortcut[] = [
  [a.parent, ['↑', '←'], t.shortcuts.or],
  [a.child, ['↓', '→'], t.shortcuts.or],
  [a.select, ['enter']],
];

const shortcutGroups = [
  { title: t.shortcuts.global, rows: globalShortcuts },
  { title: t.shortcuts.picker, rows: pickerShortcuts },
];
---

<Base title={t.title} description={t.description} current="manual">
  <div class="manual">
    <div class="manual-intro">
      <h1>{t.title}</h1>
      <p>{t.lede}</p>
    </div>

    <div class="manual-body">
      <nav class="toc" aria-label={t.sections}>
        {toc.map(([id, label], i) => (
          <a
            href={`#${id}`}
            data-toc={id}
            class:list={{ 'is-active': i === 0 }}
          >
            {label}
          </a>
        ))}
      </nav>

      <main class="sections">
        <section id="start">
          <h2>{t.toc.start}</h2>
          <p set:html={rich(t.start.open)} />
          <Shot label={t.start.shot} src={basicShot} dark={basicDarkShot} />
          <p set:html={rich(t.start.pick)} />
          <Terms>
            <Term term={t.start.fonts}>
              <Fragment set:html={t.start.fontsBody} />
            </Term>
            <Term term={t.start.position}>
              <Fragment set:html={t.start.positionBody} />
            </Term>
            <Term term={t.start.off}>
              <Fragment set:html={rich(t.start.offBody)} />
            </Term>
          </Terms>
          <Callout>{t.start.callout}</Callout>
        </section>

        <section id="profiles">
          <h2>{t.toc.profiles}</h2>
          <p>{t.profiles.intro}</p>
          <Shot
            label={t.profiles.shot}
            src={popupProfilesShot}
            dark={popupProfilesDarkShot}
          />
          <p set:html={rich(t.profiles.manage)} />
        </section>

        <section id="cli">
          <h2>{t.toc.cli}</h2>
          <p set:html={rich(t.cli.intro)} />
          <Terms>
            <Term term={t.cli.setup}>
              <Fragment
                set:html={rich(t.cli.setupBody, {
                  cli: localizePath(locale, LINKS.cli),
                })}
              />
            </Term>
            <Term term="Claude Code">
              <Fragment set:html={rich(t.cli.claudeCodeBody)} />
            </Term>
            <Term term={t.cli.privacy}>{t.cli.privacyBody}</Term>
          </Terms>
        </section>

        <section id="chat">
          <h2>{t.toc.chat}</h2>
          <p set:html={rich(t.chat.intro)} />
          <Shot label={t.chat.shot} src={chatShot} dark={chatDarkShot} />
          <Terms>
            <Term term={t.chat.key}>{t.chat.keyBody}</Term>
            <Term term={t.chat.changes}>
              <Fragment set:html={t.chat.changesBody} />
            </Term>
            <Term term={t.chat.cost}>{t.chat.costBody}</Term>
          </Terms>
        </section>

        <section id="presets">
          <h2>{t.toc.presets}</h2>
          <p set:html={rich(t.presets.intro)} />
          <Shot
            label={t.presets.shot}
            src={readabilityShot}
            dark={readabilityDarkShot}
          />
        </section>

        <section id="sync">
          <h2>{t.toc.sync}</h2>
          <Shot label={t.sync.shot} src={syncShot} dark={syncDarkShot} />
          <Terms>
            <Term term={t.sync.drive}>{t.sync.driveBody}</Term>
            <Term term={t.sync.conflicts}>{t.sync.conflictsBody}</Term>
            <Term term={t.sync.backup}>{t.sync.backupBody}</Term>
            <Term term={t.sync.history}>{t.sync.historyBody}</Term>
          </Terms>
          <Shot
            label={t.sync.historyShot}
            src={historyShot}
            dark={historyDarkShot}
          />
        </section>

        <section id="urls">
          <h2>{t.toc.urls}</h2>
          <p>{t.urls.intro}</p>
          <div class="table">
            {wildcards.map(([pattern, meaning]) => (
              <div class="table-row">
                <span class="wildcard">
                  <code>{pattern}</code>
                </span>
                <span>{meaning}</span>
              </div>
            ))}
          </div>
          <h3>{t.urls.examplesTitle}</h3>
          <Terms>
            {examples.map(([pattern, meaning]) => (
              <Term>
                <code slot="term">{pattern}</code>
                {meaning}
              </Term>
            ))}
          </Terms>
        </section>

        <section id="shortcuts">
          <h2>{t.toc.shortcuts}</h2>
          <p set:html={rich(t.shortcuts.intro)} />
          {shortcutGroups.map((group) => (
            <div class="table">
              <div class="table-head">{group.title}</div>
              {group.rows.map(([action, keys, sep]) => (
                <div class="table-row shortcut">
                  <span class="shortcut-action">{action}</span>
                  {keys ? (
                    <Keys keys={keys} sep={sep} />
                  ) : (
                    <span class="shortcut-unset">{t.shortcuts.unset}</span>
                  )}
                </div>
              ))}
            </div>
          ))}
        </section>

        <section id="help">
          <h2>{t.toc.help}</h2>
          <p
            set:html={rich(t.help.body, {
              issues: LINKS.issues,
              donate: LINKS.donate,
            })}
          />
        </section>
      </main>
    </div>
  </div>
  <ImageZoom />
</Base>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  const sections = links
    .map((link) => document.getElementById(link.dataset.toc!))
    .filter((el): el is HTMLElement => !!el);

  function setActive(id: string) {
    links.forEach((link) =>
      link.classList.toggle('is-active', link.dataset.toc === id),
    );
  }

  function onScroll() {
    let current = sections[0]?.id;
    for (const section of sections) {
      if (section.getBoundingClientRect().top < 140) current = section.id;
    }
    if (current) setActive(current);
  }

  links.forEach((link) =>
    link.addEventListener('click', () => setActive(link.dataset.toc!)),
  );
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .manual {
    max-width: 1180px;
    margin: 0 auto;
    padding: 64px 24px 0;
  }

  .manual-intro {
    max-width: 720px;
    margin-bottom: 36px;
  }

  .manual-intro h1 {
    margin: 0 0 12px;
    font: 700 clamp(34px, 4.6vw, 48px) / 1.05 var(--display);
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .manual-intro p {
    margin: 0;
    font: 400 18px/1.55 var(--ui);
    color: var(--muted);
  }

  .manual-body {
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: flex-start;
  }

  .toc {
    flex: 0 0 220px;
    margin-left: -12px;
    position: sticky;
    top: 84px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc a {
    display: block;
    padding: 7px 12px;
    border-radius: 8px;
    font: 400 14px/1.3 var(--ui);
    color: var(--muted);
  }

  .toc a:hover {
    background: var(--track);
    color: var(--ink);
  }

  .toc a.is-active {
    font-weight: 600;
    color: var(--ink);
    background: var(--track);
  }

  .sections {
    flex: 1 1 480px;
    min-width: 0;
    max-width: 720px;
  }

  section {
    scroll-margin-top: 88px;
    padding: 44px 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  h2 {
    margin: 0;
    font: 700 26px/1.2 var(--display);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  h3 {
    margin: 10px 0 0;
    font: 600 16px/1.3 var(--ui);
    color: var(--ink);
  }

  p {
    margin: 0;
    font: 400 16px/1.65 var(--ui);
    color: var(--ink2);
    text-wrap: pretty;
  }

  .sections :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .sections :global(code) {
    padding: 1px 6px;
    border-radius: 5px;
    background: var(--fill);
    border: 1px solid var(--border);
    font: 400 0.88em/1.5 var(--mono);
    color: var(--ink);
  }

  .sections :global(.keys) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }

  .sections :global(kbd) {
    display: inline-block;
    padding: 2px 7px;
    border-radius: 5px;
    background: var(--fill);
    border: 1px solid var(--strong);
    border-bottom-width: 2px;
    font: 500 12px/1.4 var(--mono);
    color: var(--ink2);
  }

  .sections :global(.keys-sep) {
    font: 400 12px/1 var(--ui);
    color: var(--faint);
  }

  .sections :global(.callout) {
    display: flex;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 10px;
    background: var(--fill);
    border: 1px solid var(--border);
    font: 400 14.5px/1.55 var(--ui);
    color: var(--ink2);
    text-wrap: pretty;
  }

  .sections :global(.callout-icon) {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 1px;
    border-radius: 9px;
    background: var(--muted);
    color: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 700 11px/1 system-ui;
  }

  .sections :global(.shot) {
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    border: 1px dashed var(--strong);
    background: var(--fill);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    text-align: center;
    font: 400 13px/1.5 var(--mono);
    color: var(--faint);
  }

  .sections :global(.shot-image) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--border);
    box-shadow: 0 8px 24px rgba(25, 27, 31, 0.08);
  }

  .sections :global(.terms) {
    margin: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }

  .sections :global(.term) {
    display: grid;
    grid-template-columns: minmax(0, 180px) minmax(0, 1fr);
    gap: 8px 24px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }

  .sections :global(.terms:last-child > .term:last-child) {
    border-bottom: none;
  }

  .sections :global(.term dt) {
    font: 600 14.5px/1.5 var(--ui);
    color: var(--ink);
  }

  .sections :global(.term dd) {
    margin: 0;
    font: 400 15px/1.6 var(--ui);
    color: var(--ink2);
    text-wrap: pretty;
  }

  .table {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface);
  }

  .table-head {
    padding: 10px 16px;
    background: var(--fill);
    border-bottom: 1px solid var(--border);
    font: 600 12px/1 var(--ui);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .table-row {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 12px 16px;
    font: 400 15px/1.55 var(--ui);
    color: var(--ink2);
  }

  .table-row + .table-row {
    border-top: 1px solid var(--border);
  }

  .wildcard {
    width: 44px;
    flex: none;
  }

  .shortcut {
    align-items: center;
    padding: 11px 16px;
  }

  .shortcut-action {
    flex: 1;
    font: 400 15px/1.4 var(--ui);
    color: var(--ink);
  }

  .shortcut-unset {
    font: 400 13px/1 var(--ui);
    color: var(--faint);
  }

  @media (max-width: 760px) {
    .manual {
      padding-top: 40px;
    }

    .manual-body {
      gap: 24px;
    }

    .toc {
      margin-left: 0;
      position: static;
      flex: 1 1 100%;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 6px;
    }

    .toc a {
      border: 1px solid var(--border);
      background: var(--surface);
    }

    .sections :global(.term) {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>
