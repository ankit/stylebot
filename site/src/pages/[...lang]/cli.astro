---
import Base from '../../layouts/Base.astro';
import CliCommand from '../../components/cli/CliCommand.astro';
import { CLI_PACKAGE, STORES } from '../../lib/links';
import { fmt, localeStaticPaths, messagesFor, rich } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const {
  site: {
    cli: { page: t },
    store,
  },
} = messagesFor(Astro.url);

const examples = [
  ['stylebot open news.ycombinator.com', t.examples.open],
  ['stylebot outline 54432929', t.examples.outline],
  ['stylebot css set news.ycombinator.com < dark.css', t.examples.css],
  ['stylebot screenshot 54432929 -o page.png', t.examples.screenshot],
];
---

<Base title={t.title} description={t.description}>
  <main class="cli">
    <div class="cli-intro">
      <h1>{t.heading}</h1>
      <p>{t.lede}</p>
    </div>

    <section>
      <h2>{t.setup}</h2>
      <ol class="cli-steps">
        <li>
          <h3>{t.install}</h3>
          <p>{t.installBody}</p>
          <div class="cli-stores">
            <a href={STORES.chrome.href} class="btn btn-outline">
              {fmt(store.add, { store: STORES.chrome.name })}
            </a>
            <a href={STORES.edge.href} class="btn btn-outline">
              {fmt(store.add, { store: STORES.edge.name })}
            </a>
          </div>
        </li>
        <li>
          <h3>{t.cli}</h3>
          <p>{t.cliBody}</p>
          <CliCommand lines={[`npm install -g ${CLI_PACKAGE}`]} />
        </li>
        <li>
          <h3>{t.connect}</h3>
          <p>{t.connectBody}</p>
          <CliCommand lines={['stylebot install']} />
        </li>
        <li>
          <h3>{t.access}</h3>
          <p set:html={rich(t.accessBody)} />
        </li>
        <li>
          <h3>
            {t.plugin} <span class="cli-optional">{t.optional}</span>
          </h3>
          <p>{t.pluginBody}</p>
          <CliCommand lines={['/plugin marketplace add ankit/stylebot']} />
          <CliCommand lines={['/plugin install stylebot@stylebot']} />
          <p>{t.tryIt}</p>
          <CliCommand
            lines={['/stylebot news.ycombinator.com give it a dark theme']}
          />
        </li>
      </ol>
    </section>

    <section>
      <h2>{t.commands}</h2>
      <p set:html={rich(t.commandsBody)} />
      <dl class="cli-examples">
        {examples.map(([command, what]) => (
          <div>
            <dt>
              <CliCommand lines={[command]} copy={false} />
            </dt>
            <dd>{what}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section>
      <h2>{t.privacy}</h2>
      {t.privacyBody.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </section>
  </main>
</Base>

<style>
  .cli {
    max-width: 720px;
    margin: 0 auto;
    padding: 64px 24px 0;
  }

  .cli-intro {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 36px;
  }

  h1 {
    margin: 0;
    font: 700 clamp(34px, 4.6vw, 48px) / 1.05 var(--display);
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
  }

  .cli-intro p {
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }

  section {
    padding: 40px 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h2 {
    margin: 0;
    font: 700 26px/1.2 var(--display);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  h3 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font: 600 16px/1.3 var(--ui);
    color: var(--ink);
  }

  p {
    margin: 0;
    font: 400 16px/1.65 var(--ui);
    color: var(--ink2);
    text-wrap: pretty;
  }

  p :global(code) {
    padding: 1px 6px;
    border-radius: 5px;
    background: var(--fill);
    border: 1px solid var(--border);
    font: 400 0.88em/1.5 var(--mono);
  }

  .cli-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .cli-steps li {
    position: relative;
    padding-left: 38px;
    counter-increment: step;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cli-steps li::before {
    content: counter(step);
    position: absolute;
    top: -1px;
    left: 0;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--strong);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 600 12px/1 var(--ui);
    color: var(--ink);
  }

  .cli-steps p {
    font-size: 15px;
    color: var(--muted);
  }

  .cli-steps p :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }

  .cli-optional {
    padding: 3px 7px;
    border-radius: 6px;
    border: 1px solid var(--border);
    font: 500 11px/1 var(--ui);
    color: var(--muted);
  }

  .cli-stores {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .cli-examples {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .cli-examples dt {
    min-width: 0;
  }

  .cli-examples dd {
    margin: 8px 0 0 12px;
    font: 400 14px/1.5 var(--ui);
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .cli {
      padding-top: 40px;
    }
  }
</style>
