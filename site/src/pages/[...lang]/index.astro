---
import Base from '../../layouts/Base.astro';
import Demo from '../../components/demo/Demo';
import Gallery from '../../components/Gallery.astro';
import Features from '../../components/Features.astro';
import CliCommand from '../../components/cli/CliCommand.astro';
import CliSection from '../../components/cli/CliSection.astro';
import Quotes from '../../components/Quotes.astro';
import Footer from '../../components/Footer.astro';
import StoreLink from '../../components/StoreLink.astro';
import { CLI_PACKAGE, LINKS, STORES } from '../../lib/links';
import {
  htmlLang,
  localeStaticPaths,
  localizePath,
  messagesFor,
  parts,
} from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const { locale, site: t, demo } = messagesFor(Astro.url);

type RestyleFont = {
  family: string;
  generic: 'serif' | 'monospace' | 'sans-serif';
  italic?: boolean;
  weight?: number;
  size?: string;
  spacing?: string;
  shift?: string;
};

type RestyleScript =
  | 'latin'
  | 'latin-ext'
  | 'vietnamese'
  | 'cyrillic'
  | 'ja'
  | 'ko'
  | 'zh-cn'
  | 'zh-tw';

const LATIN_FONTS: RestyleFont[] = [
  {
    family: 'DM Serif Display',
    generic: 'serif',
    italic: true,
    spacing: '-0.02em',
    shift: '0.027em',
  },
  {
    family: 'JetBrains Mono',
    generic: 'monospace',
    weight: 500,
    size: '0.94em',
    spacing: '-0.06em',
    shift: '0.034em',
  },
  {
    family: 'Silkscreen',
    generic: 'monospace',
    size: '0.72em',
    spacing: '0',
    shift: '0.15em',
  },
  {
    family: 'Libre Caslon Text',
    generic: 'serif',
    weight: 700,
    size: '0.95em',
    spacing: '-0.02em',
    shift: '0.039em',
  },
];

/*
 * The headline word's four styles, per script: each font is a Google Font
 * that covers the whole word, so no letter falls back to another font.
 */
const RESTYLE_FONTS: Record<RestyleScript, RestyleFont[]> = {
  latin: LATIN_FONTS,
  'latin-ext': [
    LATIN_FONTS[0],
    LATIN_FONTS[1],
    {
      family: 'Pixelify Sans',
      generic: 'monospace',
      weight: 500,
      size: '0.9em',
      spacing: '0',
      shift: '0.08em',
    },
    LATIN_FONTS[3],
  ],
  vietnamese: [
    {
      family: 'Playfair Display',
      generic: 'serif',
      italic: true,
      spacing: '-0.02em',
      shift: '-0.06em',
    },
    {
      family: 'JetBrains Mono',
      generic: 'monospace',
      weight: 500,
      size: '0.88em',
      spacing: '-0.06em',
      shift: '0em',
    },
    {
      family: 'VT323',
      generic: 'monospace',
      size: '1.1em',
      spacing: '0',
      shift: '-0.06em',
    },
    {
      family: 'Old Standard TT',
      generic: 'serif',
      weight: 700,
      size: '0.95em',
      spacing: '-0.02em',
      shift: '0.094em',
    },
  ],
  cyrillic: [
    {
      family: 'Playfair Display',
      generic: 'serif',
      italic: true,
      spacing: '-0.02em',
      shift: '0.02em',
    },
    {
      family: 'JetBrains Mono',
      generic: 'monospace',
      weight: 500,
      size: '0.94em',
      spacing: '-0.06em',
      shift: '0.034em',
    },
    {
      family: 'Pixelify Sans',
      generic: 'monospace',
      weight: 500,
      size: '0.9em',
      spacing: '0',
      shift: '0.08em',
    },
    {
      family: 'Old Standard TT',
      generic: 'serif',
      weight: 700,
      size: '0.95em',
      spacing: '-0.02em',
      shift: '0.03em',
    },
  ],
  ja: [
    { family: 'Yuji Syuku', generic: 'serif', size: '0.96em', spacing: '0' },
    {
      family: 'M PLUS 1 Code',
      generic: 'monospace',
      weight: 500,
      size: '0.94em',
      spacing: '0',
    },
    {
      family: 'DotGothic16',
      generic: 'sans-serif',
      size: '0.94em',
      spacing: '0',
    },
    {
      family: 'Shippori Mincho',
      generic: 'serif',
      weight: 700,
      size: '0.95em',
      spacing: '0',
    },
  ],
  ko: [
    { family: 'Song Myung', generic: 'serif', size: '0.94em', spacing: '0' },
    {
      family: 'Nanum Gothic Coding',
      generic: 'monospace',
      size: '0.84em',
      spacing: '0',
    },
    {
      family: 'Do Hyeon',
      generic: 'sans-serif',
      size: '0.94em',
      spacing: '0',
    },
    {
      family: 'Nanum Myeongjo',
      generic: 'serif',
      weight: 800,
      size: '0.87em',
      spacing: '0',
    },
  ],
  'zh-cn': [
    {
      family: 'Ma Shan Zheng',
      generic: 'serif',
      spacing: '0',
    },
    {
