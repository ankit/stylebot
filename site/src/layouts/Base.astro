---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LocaleSuggestion from '../components/LocaleSuggestion.astro';
import { STORAGE_KEY, THEME_KEYS, themeStylesheet } from '../lib/themes';
import {
  DEFAULT_LOCALE,
  LOCALES,
  fmt,
  htmlLang,
  localizePath,
  messagesFor,
  unlocalizedPath,
} from '../i18n';
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
  footer?: boolean;
  current?: 'manual';
  storeCta?: boolean;
  install?: boolean;
  noindex?: boolean;
  alternates?: boolean;
};

const { locale, site: t } = messagesFor(Astro.url);

const {
  title,
  description = t.meta.description,
  footer = true,
  current,
  storeCta,
  install,
  noindex,
  alternates = true,
} = Astro.props;

const fullTitle = title ? fmt(t.meta.titleSuffix, { title }) : t.meta.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = unlocalizedPath(Astro.url.pathname);
const altUrl = (code: (typeof LOCALES)[number]['code']) =>
  new URL(localizePath(code, path), Astro.site);
---

<!doctype html>
<html
  lang={htmlLang(locale)}
  translate={locale === DEFAULT_LOCALE ? undefined : 'no'}
>
  <head>
    <meta charset="utf-8" />
    {locale !== DEFAULT_LOCALE && <meta name="google" content="notranslate" />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternates &&
      LOCALES.map((l) => (
        <link rel="alternate" hreflang={l.lang} href={altUrl(l.code)} />
      ))}
    {alternates && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={altUrl(DEFAULT_LOCALE)}
      />
    )}
    <meta name="theme-color" content="#f7f8fa" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Stylebot" />
    <meta property="og:locale" content={htmlLang(locale).replace('-', '_')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@stylebot" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <slot name="head" />
    <script is:inline define:vars={{ STORAGE_KEY, THEME_KEYS }}>
      try {
        var saved = localStorage.getItem(STORAGE_KEY);
      } catch (e) {}
      document.documentElement.dataset.theme =
        (THEME_KEYS.indexOf(saved) >= 0 && saved) ||
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Gabarito:wght@600;700;800&family=Newsreader:opsz,wght@6..72,400;6..72,600;6..72,700&family=Lora:ital,wght@0,400;0,700;1,500&family=Public+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <Fragment set:html={`<style>${themeStylesheet()}</style>`} />
    {import.meta.env.PROD && (
      <>
        <script
          is:inline
          async
          src="https://plausible.io/js/pa-BGI4Ew6K-t0hsxPyst1zG.js"
        ></script>
        <script is:inline>
          window.plausible =
            window.plausible ||
            function () {
              (plausible.q = plausible.q || []).push(arguments);
            };
          plausible.init =
            plausible.init ||
            function (i) {
              plausible.o = i || {};
            };
          plausible.init();
        </script>
      </>
    )}
  </head>
  <body>
    {alternates && <LocaleSuggestion />}
    <Header current={current} storeCta={storeCta} install={install} />
    <slot />
    {footer && (
      <div class="container">
        <Footer />
      </div>
    )}
  </body>
</html>
