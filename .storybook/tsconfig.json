{
  "extends": "../tsconfig.json",
  "exclude": ["../node_modules"],
  "include": ["./**/*", "../src/**/*.stories.ts", "../shims.vue.d.ts"],
  "compilerOptions": {
    "types": ["chrome", "node"],
    "baseUrl": "../src",
    "paths": {
      "@stylebot/storybook/*": ["../.storybook/*"],
      "@/*": ["*"],
      "@stylebot/inject-css": ["apps/content/index"],
      "@stylebot/*": [
        "core/*/index",
        "features/*/index",
        "ui/*/index",
        "apps/*/index"
      ]
    },
    "skipLibCheck": true
  }
}
