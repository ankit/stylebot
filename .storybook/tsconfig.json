{
  "extends": "../tsconfig.json",
  "exclude": ["../node_modules"],
  "include": ["./**/*", "../src/**/*.stories.ts", "../shims.vue.d.ts"],
  "compilerOptions": {
    "types": ["chrome", "node"],
    "baseUrl": "../src",
    "paths": {
      "@stylebot/storybook/*": ["../.storybook/*"],
      "@/*": ["*"],
      "@stylebot/*": ["*/index"]
